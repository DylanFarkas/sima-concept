{% doc %}
  SIMA: BreadcrumbList for Google on collection and product pages, so the main departments
  (Hombre, Mujer, Zapatillas, Tech, Suplementos, Accesorios) read as the top of the site.
  A child collection hangs from the department in its handle prefix (hombre-camisetas → hombre;
  zapatos-hombre → zapatos). A product hangs from the first department it belongs to.
  Department order lives in sima_departments; keep it in sync with the main menu.
{% enddoc %}

{%- liquid
  assign sima_departments = 'hombre,mujer,zapatos,tecnologia,suplementos,accesorios' | split: ','
  assign sima_home = shop.url | append: '/'
  assign sima_parent = nil
  assign sima_current = nil

  if template.name == 'collection' and collection.handle != blank
    assign sima_current = collection
    assign sima_current_name = collection.title | split: " - " | last
    assign sima_prefix = collection.handle | split: '-' | first
    if sima_prefix != collection.handle and sima_departments contains sima_prefix
      assign sima_parent = collections[sima_prefix]
    endif
  elsif template.name == 'product' and product != blank
    assign sima_current = product
    assign sima_current_name = product.title
    for sima_handle in sima_departments
      assign sima_match = product.collections | where: 'handle', sima_handle | first
      if sima_match
        assign sima_parent = sima_match
        break
      endif
    endfor
  endif
-%}

{%- if sima_current -%}
  {%- assign sima_position = 2 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": {{ sima_home | json }}
        },
        {%- if sima_parent and sima_parent.handle != blank -%}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ sima_parent.title | json }},
            "item": {{ shop.url | append: sima_parent.url | json }}
          },
          {%- assign sima_position = 3 -%}
        {%- endif -%}
        {
          "@type": "ListItem",
          "position": {{ sima_position }},
          "name": {{ sima_current_name | json }},
          "item": {{ shop.url | append: sima_current.url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
