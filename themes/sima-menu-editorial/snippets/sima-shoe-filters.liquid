{% doc %}
  Casillas de género y disciplina para las colecciones de zapatillas.
  Son filtros nativos de Search & Discovery sobre los metacampos de producto
  custom.audiencia (filtro «Género») y custom.disciplina (filtro «Disciplina»).
  Las opciones son fijas para que Basketball se vea aunque no tenga productos.
  Va dentro del formulario de filtros: al marcar una casilla, la grilla filtra sola.
{% enddoc %}

{%- liquid
  assign sima_shoe = false
  if collection.handle == 'zapatos' or collection.handle == 'zapatos-hombre' or collection.handle == 'zapatos-mujer' or collection.handle == 'zapatos-unisex'
    assign sima_shoe = true
  endif
  assign sima_shoe_parent = false
  if collection.handle == 'zapatos'
    assign sima_shoe_parent = true
  endif

  assign sima_aud_param = 'filter.p.m.custom.audiencia'
  assign sima_dis_param = 'filter.p.m.custom.disciplina'
  assign sima_aud_active = '|'
  assign sima_dis_active = '|'
  assign sima_aud_count = 0
  assign sima_dis_count = 0
  for sima_filter in collection.filters
    if sima_filter.param_name == sima_aud_param
      for sima_value in sima_filter.active_values
        assign sima_aud_active = sima_aud_active | append: sima_value.value | append: '|'
        assign sima_aud_count = sima_aud_count | plus: 1
      endfor
    elsif sima_filter.param_name == sima_dis_param
      for sima_value in sima_filter.active_values
        assign sima_dis_active = sima_dis_active | append: sima_value.value | append: '|'
        assign sima_dis_count = sima_dis_count | plus: 1
      endfor
    endif
  endfor
-%}

{%- if sima_shoe and sima_shoe_parent -%}
  <details class="sima-grilla__filter" open>
    <summary>Género{%- if sima_aud_count > 0 %} ({{ sima_aud_count }}){%- endif -%}</summary>
    <ul class="sima-grilla__options">
      {%- assign sima_genders = 'Hombre,Mujer,Unisex' | split: ',' -%}
      {%- for sima_label in sima_genders -%}
        {%- assign sima_key = '|' | append: sima_label | append: '|' -%}
        <li>
          <label class="sima-grilla__check">
            <input
              type="checkbox"
              name="{{ sima_aud_param }}"
              value="{{ sima_label }}"
              {% if sima_aud_active contains sima_key %}checked{% endif %}
            >
            <span>{{ sima_label }}</span>
          </label>
        </li>
      {%- endfor -%}
    </ul>
  </details>
{%- endif -%}

{%- if sima_shoe -%}
  <details class="sima-grilla__filter" open>
    <summary>Disciplina{%- if sima_dis_count > 0 %} ({{ sima_dis_count }}){%- endif -%}</summary>
    <ul class="sima-grilla__options">
      {%- assign sima_disciplines = 'Running,Hiking,Training,Basketball,Classic' | split: ',' -%}
      {%- for sima_label in sima_disciplines -%}
        {%- assign sima_key = '|' | append: sima_label | append: '|' -%}
        <li>
          <label class="sima-grilla__check">
            <input
              type="checkbox"
              name="{{ sima_dis_param }}"
              value="{{ sima_label }}"
              {% if sima_dis_active contains sima_key %}checked{% endif %}
            >
            <span>{{ sima_label }}</span>
          </label>
        </li>
      {%- endfor -%}
    </ul>
  </details>
{%- endif -%}
