{% doc %}
  Casillas de género y disciplina para las colecciones de zapatillas.
  Usan el filtro nativo por etiqueta de la misma colección.
  @param {string} sort - Orden actual, se conserva en el enlace
{% enddoc %}

{%- liquid
  assign sima_shoe = false
  if collection.handle == 'zapatos' or collection.handle == 'zapatos-hombre' or collection.handle == 'zapatos-mujer' or collection.handle == 'zapatos-unisex'
    assign sima_shoe = true
  endif
  assign sima_shoe_parent = false
  if collection.handle == 'zapatos'
    assign sima_shoe_parent = true
  endif
  assign sima_audience = ''
  assign sima_discipline = ''
  for sima_tag in current_tags
    assign sima_handle = sima_tag | handle
    if sima_handle contains 'audiencia-'
      assign sima_audience = sima_handle
    elsif sima_handle contains 'disciplina-'
      assign sima_discipline = sima_handle
    endif
  endfor
-%}

{%- if sima_shoe and sima_shoe_parent -%}
  <details class="sima-grilla__filter" open>
    <summary>Género{%- if sima_audience != blank %} (1){%- endif -%}</summary>
    <ul class="sima-grilla__options">
      {%- assign sima_genders = 'Hombre|audiencia-hombre||Mujer|audiencia-mujer||Unisex|audiencia-unisex' | split: '||' -%}
      {%- for sima_row in sima_genders -%}
        {%- assign sima_pair = sima_row | split: '|' -%}
        {%- assign sima_label = sima_pair | first -%}
        {%- assign sima_value = sima_pair | last -%}
        {%- assign sima_next = sima_value -%}
        {%- if sima_audience == sima_value -%}
          {%- assign sima_next = '' -%}
        {%- endif -%}
        {%- assign sima_parts = sima_next -%}
        {%- if sima_discipline != blank -%}
          {%- if sima_parts != blank -%}
            {%- assign sima_parts = sima_parts | append: '+' | append: sima_discipline -%}
          {%- else -%}
            {%- assign sima_parts = sima_discipline -%}
          {%- endif -%}
        {%- endif -%}
        {%- if sima_parts == blank -%}
          {%- assign sima_href = collection.url -%}
        {%- else -%}
          {%- assign sima_href = collection.url | append: '/' | append: sima_parts -%}
        {%- endif -%}
        {%- if sort != blank -%}
          {%- assign sima_href = sima_href | append: '?sort_by=' | append: sort -%}
        {%- endif -%}
        <li>
          <a class="sima-grilla__check" href="{{ sima_href }}">
            <span class="sima-grilla__tick"{% if sima_audience == sima_value %} data-on{% endif %}></span>
            <span>{{ sima_label }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </details>
{%- endif -%}

{%- if sima_shoe -%}
  <details class="sima-grilla__filter" open>
    <summary>Disciplina{%- if sima_discipline != blank %} (1){%- endif -%}</summary>
    <ul class="sima-grilla__options">
      {%- assign sima_disciplines = 'Running|disciplina-running||Hiking|disciplina-hiking||Training|disciplina-training||Basketball|disciplina-basketball||Classic|disciplina-classic' | split: '||' -%}
      {%- for sima_row in sima_disciplines -%}
        {%- assign sima_pair = sima_row | split: '|' -%}
        {%- assign sima_label = sima_pair | first -%}
        {%- assign sima_value = sima_pair | last -%}
        {%- assign sima_next = sima_value -%}
        {%- if sima_discipline == sima_value -%}
          {%- assign sima_next = '' -%}
        {%- endif -%}
        {%- assign sima_parts = '' -%}
        {%- if sima_shoe_parent and sima_audience != blank -%}
          {%- assign sima_parts = sima_audience -%}
        {%- endif -%}
        {%- if sima_next != blank -%}
          {%- if sima_parts != blank -%}
            {%- assign sima_parts = sima_parts | append: '+' | append: sima_next -%}
          {%- else -%}
            {%- assign sima_parts = sima_next -%}
          {%- endif -%}
        {%- endif -%}
        {%- if sima_parts == blank -%}
          {%- assign sima_href = collection.url -%}
        {%- else -%}
          {%- assign sima_href = collection.url | append: '/' | append: sima_parts -%}
        {%- endif -%}
        {%- if sort != blank -%}
          {%- assign sima_href = sima_href | append: '?sort_by=' | append: sort -%}
        {%- endif -%}
        <li>
          <a class="sima-grilla__check" href="{{ sima_href }}">
            <span class="sima-grilla__tick"{% if sima_discipline == sima_value %} data-on{% endif %}></span>
            <span>{{ sima_label }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </details>
{%- endif -%}
