{% doc %}
  Quiet help-page links, matching the concept.
  @param {string} current - Handle of the page being viewed
  @example
  {% render 'sima-ayuda-nav', current: 'guia-de-tallas' %}
{% enddoc %}

<nav class="sima-ayuda-nav" aria-label="Ayuda">
  <ul>
    {%- assign items = 'Guía de tallas|guia-de-tallas,Preguntas frecuentes|preguntas-frecuentes,Envíos|envios,Cambios y devoluciones|cambios-y-devoluciones,Política de privacidad|politica-de-privacidad' | split: ',' -%}
    {%- for item in items -%}
      {%- assign parts = item | split: '|' -%}
      {%- assign item_handle = parts[1] -%}
      <li>
        {%- if item_handle == 'politica-de-privacidad' -%}
          <a href="{{ pages['politica-de-privacidad'].url | default: '/policies/privacy-policy' }}" {% if current == item_handle %}aria-current="page"{% endif %}>
            {{ parts[0] }}
          </a>
        {%- else -%}
          <a href="{{ pages[item_handle].url }}" {% if current == item_handle %}aria-current="page"{% endif %}>
            {{ parts[0] }}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{% stylesheet %}
  .sima-ayuda {
    display: block;
    background: #121212;
    color: #fff;
  }

  .sima-ayuda__wrap {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sima-ayuda__hero {
    padding: 3.5rem 0 3rem;
  }

  @media (min-width: 750px) {
    .sima-ayuda__hero {
      padding: 5rem 0 3.5rem;
    }
  }

  @media (min-width: 990px) {
    .sima-ayuda__hero {
      padding: 7rem 0 5rem;
    }
  }

  .sima-ayuda__grid {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }

  @media (min-width: 990px) {
    .sima-ayuda__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 3rem;
    }

    .sima-ayuda__title {
      grid-column: span 7;
    }

    .sima-ayuda__intro {
      grid-column: span 5;
      padding-bottom: 0.5rem;
    }
  }

  .sima-ayuda__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.75rem, 13vw, 5.5rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  @media (min-width: 990px) {
    .sima-ayuda__title {
      font-size: clamp(4rem, 6.6vw, 7.5rem);
    }
  }

  .sima-ayuda__title span {
    display: block;
  }

  .sima-ayuda__stroke {
    color: transparent;
    -webkit-text-stroke: 1.5px #fff;
  }

  .sima-ayuda__kicker {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .sima-ayuda__lead {
    max-width: 46ch;
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.75);
  }

  .sima-ayuda__lead a,
  .sima-ayuda a.sima-ayuda__link {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-underline-offset: 5px;
  }

  .sima-ayuda-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    max-width: 48rem;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sima-ayuda-nav a {
    color: rgb(255 255 255 / 0.4);
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .sima-ayuda-nav a:hover,
  .sima-ayuda-nav a[aria-current='page'] {
    color: #fff;
  }

  .sima-ayuda-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .sima-ayuda-nav a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
{% endstylesheet %}
