{% doc %}
  Ícono de trazo de un anuncio. Sin marco: el trazo va suelto junto a la frase.

  @param {string} icon - lock, truck, card o tag
{% enddoc %}

<svg class="sima-anuncios__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case icon %}
    {% when 'truck' %}
      <rect x="3.6" y="5.8" width="10.6" height="9.4" rx="0.8"></rect>
      <path d="M14.2 9.2h3.5l2.7 2.8v3.2h-6.2z"></path>
      <circle cx="8.2" cy="16.9" r="1.8"></circle>
      <circle cx="17.4" cy="16.9" r="1.8"></circle>
    {% when 'card' %}
      <rect x="3.2" y="5.6" width="17.6" height="12.8" rx="1.6"></rect>
      <path d="M3.2 9.6h17.6"></path>
      <path d="M6.6 14.6h4"></path>
    {% when 'tag' %}
      <path d="M3.8 12.6V4.8c0-.6.4-1 1-1h7.8l7.6 7.6c.4.4.4 1 0 1.4l-7.4 7.4c-.4.4-1 .4-1.4 0l-7.6-7.6Z"></path>
      <circle cx="8.4" cy="8.4" r="1.4"></circle>
    {% else %}
      <path d="M12 3.2 18.7 5.6v5.1c0 4.2-2.8 7.9-6.7 8.9-3.9-1-6.7-4.7-6.7-8.9V5.6L12 3.2Z"></path>
      <rect x="9.3" y="10.6" width="5.4" height="4.4" rx="0.9"></rect>
      <path d="M10.4 10.6V9a1.6 1.6 0 0 1 3.2 0v1.6"></path>
  {% endcase %}
</svg>
