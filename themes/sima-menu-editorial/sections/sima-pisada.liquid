<sima-pisada class="sima-pisada" style="--sima-pisada-bg: {{ section.settings.background }};">
  <div class="sima-pisada__head">
    <h2 class="sima-pisada__title">{{ section.settings.heading }}</h2>
    <div class="sima-pisada__actions">
      {%- if section.settings.collection != blank and section.settings.link_label != blank -%}
        <a class="sima-pisada__link" href="{{ section.settings.collection.url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
      <div class="sima-pisada__nav">
        <button class="sima-pisada__arrow" type="button" data-dir="-1" aria-label="Anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 5-7 7 7 7" />
          </svg>
        </button>
        <button class="sima-pisada__arrow" type="button" data-dir="1" aria-label="Siguiente">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 5 7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <ul class="sima-pisada__track" data-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign shoe = block.settings.product
        assign photo = block.settings.image
        if photo == blank and shoe != blank
          assign photo = shoe.featured_image
        endif
      -%}
      <li class="sima-pisada__item" {{ block.shopify_attributes }}>
        {%- if shoe != blank -%}
          <a class="sima-pisada__card" href="{{ shoe.url }}">
        {%- else -%}
          <div class="sima-pisada__card">
        {%- endif -%}
          <span class="sima-pisada__photo">
            {%- if photo != blank -%}
              {{
                photo
                | image_url: width: 1000
                | image_tag:
                  alt: '',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 1536px) 460px, (min-width: 990px) 30vw, (min-width: 640px) 46vw, 78vw'
              }}
            {%- endif -%}
            <span class="sima-pisada__shade"></span>
            {%- if block.settings.word != blank -%}
              <span class="sima-pisada__word">{{ block.settings.word }}</span>
            {%- endif -%}
          </span>
          {%- if shoe != blank -%}
            <span class="sima-pisada__meta">
              <span class="sima-pisada__name">{{ shoe.title }}</span>
              <span class="sima-pisada__price">{{ shoe.price | money }}</span>
            </span>
          {%- endif -%}
        {%- if shoe != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</sima-pisada>

{% stylesheet %}
  .sima-pisada {
    display: block;
    background: var(--sima-pisada-bg, #121212);
    color: #fff;
    padding-block: 5rem;
  }

  .sima-pisada__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sima-pisada__title {
    flex: 1;
    min-width: 0;
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .sima-pisada__actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.25rem;
  }

  .sima-pisada__link {
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .sima-pisada__nav {
    display: none;
    gap: 0.5rem;
  }

  .sima-pisada__arrow {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    cursor: pointer;
  }

  .sima-pisada__arrow svg {
    width: 1rem;
    height: 1rem;
  }

  .sima-pisada__arrow:hover {
    background: #fff;
    color: #121212;
  }

  .sima-pisada__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .sima-pisada__arrow:disabled:hover {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
  }

  .sima-pisada__card:focus-visible,
  .sima-pisada__link:focus-visible,
  .sima-pisada__arrow:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .sima-pisada__track {
    --rail-inset: max(var(--page-margin), calc((100vw - min(100vw, var(--page-width))) / 2 + var(--page-margin)));
    display: flex;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    padding-inline: var(--rail-inset);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--rail-inset);
    list-style: none;
    scrollbar-width: none;
  }

  .sima-pisada__track::-webkit-scrollbar {
    display: none;
  }

  .sima-pisada__item {
    flex: 0 0 auto;
    width: 78vw;
    scroll-snap-align: start;
  }

  .sima-pisada__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .sima-pisada__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #161616;
  }

  .sima-pisada__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sima-pisada__shade {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 40%;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.7), transparent);
  }

  .sima-pisada__word {
    position: absolute;
    inset-inline: 0;
    top: 0;
    padding: 1rem 1.25rem 0;
    overflow: hidden;
    font-family: var(--font-heading--family);
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .sima-pisada__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .sima-pisada__name {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.375;
  }

  .sima-pisada__price {
    flex-shrink: 0;
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  @media screen and (min-width: 640px) {
    .sima-pisada__nav {
      display: flex;
    }

    .sima-pisada__item {
      width: 46vw;
    }
  }

  @media screen and (min-width: 990px) {
    .sima-pisada {
      padding-block: 7rem;
    }

    .sima-pisada__track {
      margin-top: 2.5rem;
    }

    .sima-pisada__item {
      width: calc((min(100vw, var(--page-width)) - (var(--page-margin) * 2) - 1.5rem) / 3);
    }
  }

  @media screen and (min-width: 1536px) {
    .sima-pisada__item {
      width: min(28.75rem, calc((min(100vw, var(--page-width)) - (var(--page-margin) * 2) - 1.5rem) / 3));
    }
  }
{% endstylesheet %}

{% javascript %}
  class SimaPisada extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.prev = this.querySelector('[data-dir="-1"]');
      this.next = this.querySelector('[data-dir="1"]');
      this.onPrev = () => this.move(-1);
      this.onNext = () => this.move(1);
      this.onScroll = () => this.update();
      this.onResize = () => this.update();

      if (this.prev) this.prev.addEventListener('click', this.onPrev);
      if (this.next) this.next.addEventListener('click', this.onNext);
      if (this.track) this.track.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onResize);
      this.update();
    }

    disconnectedCallback() {
      if (this.prev && this.onPrev) this.prev.removeEventListener('click', this.onPrev);
      if (this.next && this.onNext) this.next.removeEventListener('click', this.onNext);
      if (this.track && this.onScroll) this.track.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('resize', this.onResize);
    }

    move(direction) {
      if (!this.track) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.track.scrollBy({
        left: direction * this.track.clientWidth * 0.8,
        behavior: reduce ? 'auto' : 'smooth',
      });
    }

    update() {
      if (!this.track) return;
      const max = this.track.scrollWidth - this.track.clientWidth;
      if (this.prev) this.prev.disabled = this.track.scrollLeft <= 2;
      if (this.next) this.next.disabled = max <= 2 || this.track.scrollLeft >= max - 2;
    }
  }

  if (!customElements.get('sima-pisada')) {
    customElements.define('sima-pisada', SimaPisada);
  }
{% endjavascript %}

{% schema %}
{
  "name": "SIMA — Pisada firme",
  "tag": "section",
  "class": "sima-pisada-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Ligereza y soporte en cada kilómetro"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Enlace",
      "default": "Ver zapatillas"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección del enlace"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "shoe",
      "name": "Zapatilla",
      "settings": [
        {
          "type": "text",
          "id": "word",
          "label": "Marca",
          "default": "Salomon"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto propia"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "SIMA — Pisada firme"
    }
  ]
}
{% endschema %}
