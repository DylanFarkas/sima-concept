<sima-equipo class="sima-equipo" style="--sima-equipo-bg: {{ section.settings.background }};">
  <div class="sima-equipo__inner">
    <h2 class="sima-equipo__title">{{ section.settings.heading }}</h2>
    <ul class="sima-equipo__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign photo = block.settings.image
          if photo == blank and block.settings.product != blank
            assign photo = block.settings.product.featured_image
          endif

          assign card_url = ''
          if block.settings.collection != blank
            assign card_url = block.settings.collection.url
          endif

          assign button_label = block.settings.button_label
          if button_label == blank
            assign button_label = 'Ver todo'
          endif
        -%}
        <li class="sima-equipo__item" {{ block.shopify_attributes }}>
          {%- if card_url != blank -%}
            <a class="sima-equipo__card" href="{{ card_url }}">
          {%- else -%}
            <div class="sima-equipo__card">
          {%- endif -%}
            <span class="sima-equipo__photo">
              {%- if photo != blank -%}
                {{
                  photo
                  | image_url: width: 1200
                  | image_tag:
                    alt: '',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) 30vw, (min-width: 640px) 46vw, 78vw'
                }}
              {%- endif -%}
            </span>
            <span class="sima-equipo__shade"></span>
            <span class="sima-equipo__bar">
              <span class="sima-equipo__label">{{ block.settings.label }}</span>
              <span class="sima-equipo__cta">{{ button_label }}</span>
            </span>
          {%- if card_url != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="sima-equipo__text">{{ block.settings.text }}</p>
          {%- endif -%}

          {%- if block.settings.link_1_collection != blank or block.settings.link_2_collection != blank or block.settings.link_3_collection != blank or block.settings.link_4_collection != blank -%}
            <ul class="sima-equipo__links">
              {%- if block.settings.link_1_collection != blank -%}
                <li>
                  <a href="{{ block.settings.link_1_collection.url }}">
                    {%- if block.settings.link_1_label != blank -%}
                      {{ block.settings.link_1_label }}
                    {%- else -%}
                      {{ block.settings.link_1_collection.title }}
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
              {%- if block.settings.link_2_collection != blank -%}
                <li>
                  <a href="{{ block.settings.link_2_collection.url }}">
                    {%- if block.settings.link_2_label != blank -%}
                      {{ block.settings.link_2_label }}
                    {%- else -%}
                      {{ block.settings.link_2_collection.title }}
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
              {%- if block.settings.link_3_collection != blank -%}
                <li>
                  <a href="{{ block.settings.link_3_collection.url }}">
                    {%- if block.settings.link_3_label != blank -%}
                      {{ block.settings.link_3_label }}
                    {%- else -%}
                      {{ block.settings.link_3_collection.title }}
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
              {%- if block.settings.link_4_collection != blank -%}
                <li>
                  <a href="{{ block.settings.link_4_collection.url }}">
                    {%- if block.settings.link_4_label != blank -%}
                      {{ block.settings.link_4_label }}
                    {%- else -%}
                      {{ block.settings.link_4_collection.title }}
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</sima-equipo>

{% stylesheet %}
  .sima-equipo {
    display: block;
    background: var(--sima-equipo-bg, #121212);
    color: #fff;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .sima-equipo__inner {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sima-equipo__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .sima-equipo__grid {
    display: flex;
    gap: 0.75rem;
    margin: 2.5rem calc(var(--page-margin) * -1) 0;
    padding: 0 var(--page-margin);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin);
    list-style: none;
    scrollbar-width: none;
  }

  .sima-equipo__grid::-webkit-scrollbar {
    display: none;
  }

  .sima-equipo__item {
    flex: 0 0 auto;
    width: 78vw;
    scroll-snap-align: start;
  }

  .sima-equipo__card {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: #161616;
    color: inherit;
    text-decoration: none;
  }

  .sima-equipo__photo,
  .sima-equipo__photo img,
  .sima-equipo__shade,
  .sima-equipo__bar {
    position: absolute;
  }

  .sima-equipo__photo,
  .sima-equipo__shade {
    inset: 0;
  }

  .sima-equipo__photo img {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sima-equipo__shade {
    background: linear-gradient(to top, rgb(0 0 0 / 0.7), transparent 55%);
  }

  .sima-equipo__bar {
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
  }

  .sima-equipo__label {
    min-width: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .sima-equipo__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.25rem;
    background: #fff;
    color: #121212;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    transition: background-color 300ms ease;
  }

  .sima-equipo__card:hover .sima-equipo__cta {
    background: #f2efe9;
  }

  .sima-equipo__text {
    margin: 1rem 0 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.75);
  }

  .sima-equipo__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sima-equipo__links a {
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.4);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color 300ms ease;
  }

  .sima-equipo__links a:hover {
    text-decoration-color: #fff;
  }

  .sima-equipo__card:focus-visible,
  .sima-equipo__links a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  @media screen and (min-width: 640px) {
    .sima-equipo__item {
      width: 46vw;
    }

    .sima-equipo__bar {
      padding: 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .sima-equipo {
      padding-bottom: 7rem;
    }

    .sima-equipo__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin: 3rem 0 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .sima-equipo__item {
      width: auto;
      min-width: 0;
      scroll-snap-align: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sima-equipo__cta,
    .sima-equipo__links a {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SIMA — Tu equipo",
  "tag": "section",
  "class": "sima-equipo-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Completa tu equipo"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tarjeta",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nombre",
          "default": "Tech"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Tecnología que impulsa tu entrenamiento."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón",
          "default": "Ver todo"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Producto de la foto"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto propia"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Enlace 1"
        },
        {
          "type": "collection",
          "id": "link_1_collection",
          "label": "Colección 1"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Enlace 2"
        },
        {
          "type": "collection",
          "id": "link_2_collection",
          "label": "Colección 2"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Enlace 3"
        },
        {
          "type": "collection",
          "id": "link_3_collection",
          "label": "Colección 3"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Enlace 4"
        },
        {
          "type": "collection",
          "id": "link_4_collection",
          "label": "Colección 4"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SIMA — Tu equipo"
    }
  ]
}
{% endschema %}
