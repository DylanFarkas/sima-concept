{%- liquid
  assign sima_product = section.settings.product
  assign sima_slides = section.blocks | where: 'type', 'escena'
  assign sima_show = false
  if section.settings.parent != blank and collection.handle == section.settings.parent
    if sima_product != blank or sima_slides.size > 0
      assign sima_show = true
    endif
  endif
-%}

{%- if sima_show -%}
  {%- liquid
    assign sima_img = section.settings.image
    if sima_img == blank
      assign sima_img = sima_product.featured_image
    endif

    assign sima_title = section.settings.title | default: sima_product.title | strip
    assign sima_words = sima_title | split: ' '
    assign sima_last = sima_words | last
    assign sima_first = sima_title | remove_last: sima_last | strip
    if section.settings.title_outline != blank
      assign sima_first = sima_title
      assign sima_last = section.settings.title_outline
    endif

    assign sima_pos = section.settings.image_position | default: 'center' | prepend: 'object-position: '
    assign sima_tone = section.settings.tone | default: 'blanco'
    assign sima_layout = section.settings.layout | default: 'dividida'
    assign sima_cutout = section.settings.cutout
    if sima_layout == 'escena' and sima_cutout == blank and sima_slides.size == 0
      assign sima_layout = 'dividida'
    endif
    if sima_layout == 'dividida' and sima_product == blank
      assign sima_layout = 'escena'
    endif
  -%}

  {% style %}
    .sima-destacado,
    .sd-slide[data-tone='blanco'] {
      --sd-bg: #fff;
      --sd-ink: #121212;
      --sd-mute: rgb(18 18 18 / 0.55);
      --sd-line: rgb(18 18 18 / 0.1);
      --sd-frame: #f4f4f2;
      --sd-stroke: #121212;
      --sd-btn-bg: #121212;
      --sd-btn-fg: #fff;
      --sd-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sima-destacado {
      display: block;
      background: var(--sd-stage-bg, var(--sd-bg));
      color: var(--sd-ink);
    }

    .sima-destacado--crema,
    .sd-slide[data-tone='crema'] {
      --sd-bg: #f2efe9;
      --sd-frame: #e8e4dc;
    }

    .sima-destacado--oscuro,
    .sd-slide[data-tone='oscuro'] {
      --sd-bg: #121212;
      --sd-ink: #fff;
      --sd-mute: rgb(255 255 255 / 0.58);
      --sd-line: rgb(255 255 255 / 0.12);
      --sd-frame: #1a1a1a;
      --sd-stroke: #bcb1a6;
      --sd-btn-bg: #fff;
      --sd-btn-fg: #121212;
    }

    .sima-destacado__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
      max-width: var(--page-width, 120rem);
      margin-inline: auto;
      padding: 4rem var(--page-margin, 1.25rem) 4.5rem;
    }

    .sima-destacado__figure {
      margin: 0;
    }

    .sima-destacado__frame {
      position: relative;
      display: block;
      aspect-ratio: {{ section.settings.ratio | default: '1' }};
      overflow: hidden;
      background: var(--sd-frame);
    }

    .sima-destacado__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .sima-destacado__caption {
      margin-top: 0.875rem;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .sima-destacado__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-width: 0;
    }

    .sima-destacado__eyebrow {
      margin: 0 0 1.75rem;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      line-height: 1;
      text-transform: uppercase;
    }

    .sima-destacado__title {
      margin: 0;
      color: var(--sd-ink);
      font-family: var(--font-heading--family);
      font-size: clamp(3rem, 14vw, 4.5rem);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .sima-destacado__title span {
      display: block;
    }

    .sima-destacado__title .is-stroke {
      color: transparent;
      -webkit-text-stroke: 1.25px var(--sd-stroke);
    }

    .sima-destacado__text {
      max-width: 32ch;
      margin: 1.75rem 0 0;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.9375rem;
      line-height: 1.65;
      text-wrap: pretty;
    }

    .sima-destacado__specs {
      width: 100%;
      max-width: 24rem;
      margin: 2rem 0 0;
      padding: 0;
      list-style: none;
    }

    .sima-destacado__spec {
      padding-block: 0.75rem;
      border-top: 1px solid var(--sd-line);
      color: var(--sd-ink);
      font-family: var(--font-body--family);
      font-size: 0.8125rem;
      line-height: 1.45;
    }

    .sima-destacado__buy {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 1.5rem;
      width: 100%;
      max-width: 24rem;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--sd-line);
    }

    .sima-destacado__price {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
      margin: 0;
      font-family: var(--font-heading--family);
      font-size: 1.375rem;
      font-weight: 700;
      line-height: 1;
    }

    .sima-destacado__price s {
      color: var(--sd-mute);
      font-size: 0.9375rem;
      font-weight: 500;
    }

    .sima-destacado__cta {
      display: inline-flex;
      align-items: center;
      padding: 1rem 1.625rem;
      background: var(--sd-btn-bg);
      color: var(--sd-btn-fg);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      line-height: 1;
      text-decoration: none;
      text-transform: uppercase;
      transition: opacity 200ms ease, transform 120ms var(--sd-ease);
    }

    @media (hover: hover) {
      .sima-destacado__cta:hover {
        opacity: 0.85;
      }
    }

    .sima-destacado__cta:active {
      transform: scale(0.97);
    }

    .sima-destacado .sima-destacado__cta::after {
      content: none !important;
      display: none !important;
      animation: none !important;
    }

    .sima-destacado__cta:focus-visible {
      outline: 2px solid var(--sd-ink);
      outline-offset: 3px;
    }

    .sima-destacado__note {
      margin: 1rem 0 0;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.75rem;
      line-height: 1.4;
    }

    .sima-destacado__head,
    .sima-destacado__foot {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    /* El tema anula el margen superior del primer hijo: el aire va en el contenedor */
    .sima-destacado__foot {
      padding-top: 1.75rem;
    }

    .sima-destacado__foot > :first-child {
      margin-top: 0;
    }

    /* Celular: titulo arriba, foto a sangre en medio, frase y compra debajo */
    @media screen and (max-width: 989px) {
      .sima-destacado__inner {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding-block: 3.5rem 4rem;
      }

      .sima-destacado__body {
        display: contents;
      }

      .sima-destacado__head {
        order: 1;
      }

      .sima-destacado__figure {
        order: 2;
        margin: 1.75rem calc(-1 * var(--page-margin, 1.25rem)) 0;
      }

      .sima-destacado__foot {
        order: 3;
        padding-top: 1.5rem;
      }

      .sima-destacado__eyebrow {
        margin-bottom: 0.875rem;
      }

      .sima-destacado__title {
        font-size: clamp(2.5rem, 11.5vw, 3.75rem);
        line-height: 0.95;
      }

      .sima-destacado__title span {
        display: inline;
      }

      .sima-destacado__title span + span {
        margin-left: 0.22em;
      }

      .sima-destacado__caption {
        padding-inline: var(--page-margin, 1.25rem);
      }

      .sima-destacado__text {
        max-width: 36ch;
      }

      .sima-destacado__specs,
      .sima-destacado__buy {
        max-width: none;
      }

      .sima-destacado__buy {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
      }
    }

    @media screen and (min-width: 990px) {
      .sima-destacado__inner {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: center;
        gap: 0 clamp(1.5rem, 2.5vw, 3rem);
        padding-block: clamp(6rem, 10vw, 10rem);
      }

      .sima-destacado__figure {
        grid-column: 1 / span 6;
      }

      .sima-destacado__body {
        grid-column: 8 / span 5;
      }

      .sima-destacado--reverse .sima-destacado__figure {
        grid-column: 7 / span 6;
        grid-row: 1;
      }

      .sima-destacado--reverse .sima-destacado__body {
        grid-column: 1 / span 5;
        grid-row: 1;
      }

      .sima-destacado__title {
        font-size: clamp(4rem, 5.8vw, 6.25rem);
      }
    }


    /* ---------- Composición «Escena»: el producto recortado entre las letras ---------- */
    .sd-escena__inner {
      max-width: var(--page-width, 120rem);
      margin-inline: auto;
      padding: var(--sd-pt-m, 2rem) var(--page-margin, 1.25rem) 4rem;
    }

    .sd-escena__top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      margin: 0 0 1.5rem;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      line-height: 1;
      text-transform: uppercase;
    }

    .sd-escena__top p {
      margin: 0;
    }

    .sd-escena__stage {
      container-type: inline-size;
      display: grid;
      align-items: center;
      justify-items: center;
      isolation: isolate;
    }

    .sd-escena__stage > * {
      grid-area: 1 / 1;
    }

    .sd-escena__word {
      position: relative;
      align-self: start;
      width: 100%;
      margin: 0;
      color: var(--sd-ink);
      font-family: var(--font-heading--family);
      font-size: 24vw;
      font-size: var(--sd-word, 26cqi);
      font-weight: 700;
      line-height: 0.84;
      letter-spacing: -0.01em;
      text-align: center;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .sd-escena__word span {
      display: block;
    }

    /* Aire entre AIRPODS y PRO 3; igual en las dos capas para que el contorno calce */
    .sd-escena__word span + span {
      margin-top: var(--sd-gap, 0.1em);
    }

    .sd-escena__word--back {
      z-index: 1;
    }

    .sd-escena__word--front {
      z-index: 3;
      pointer-events: none;
    }

    .sd-escena__word .is-ghost {
      color: transparent;
      -webkit-text-stroke: 0;
    }

    .sd-escena__word .is-stroke {
      color: transparent;
      -webkit-text-stroke: max(1px, 0.12cqi) var(--sd-stroke);
    }

    .sd-escena__product {
      position: relative;
      z-index: 2;
      display: block;
      width: var(--sd-size-m, 84%);
      height: auto;
      align-self: start;
      margin-top: var(--sd-offset-m, 8%);
      filter: drop-shadow(0 2.25rem 2rem rgb(0 0 0 / 0.16)) drop-shadow(0 0.5rem 0.75rem rgb(0 0 0 / 0.08));
    }

    .sd-escena__info {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--sd-line);
    }

    .sd-escena__text {
      max-width: 36ch;
      margin: 0;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.9375rem;
      line-height: 1.65;
      text-wrap: pretty;
    }

    .sd-escena__buy {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 2rem;
    }

    /* ---------- Carrusel ---------- */
    .sd-slides {
      display: grid;
    }

    .sd-slide {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .sd-slide:not(.is-active) {
      visibility: hidden;
      pointer-events: none;
    }

    .sd-slide .sd-escena__info {
      margin-top: auto;
    }

    /* Todas las escenas miden lo mismo (sin saltos al cambiar): la más baja centra su
       producto en el espacio que sobra */
    .sd-slide .sd-escena__stage {
      flex: 1 0 auto;
      align-content: center;
      margin-bottom: 2rem;
    }

    /* ---------- Transición entre productos ---------- */
    .sima-destacado--escena {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }

    /* Capa del color nuevo: se abre en círculo desde el producto */
    .sd-bgfx {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .sd-escena__inner {
      position: relative;
      z-index: 1;
    }

    .sd-slide.is-active {
      z-index: 2;
    }

    .sd-slide.is-leaving {
      z-index: 1;
      visibility: visible;
    }

    .sd-escena__word {
      pointer-events: none;
    }

    .sd-anim .sd-slide.is-entering .sd-escena__word span {
      animation: sd-line-in 0.95s var(--sd-ease) both;
      animation-delay: 0.58s;
    }

    .sd-anim .sd-slide.is-entering .sd-escena__word span + span {
      animation-delay: 0.68s;
    }

    .sd-anim .sd-slide.is-leaving .sd-escena__word span {
      animation: sd-line-out 0.42s cubic-bezier(0.7, 0, 0.84, 0) both;
    }

    .sd-anim .sd-slide.is-leaving .sd-escena__word span + span {
      animation-delay: 0.04s;
    }

    .sd-anim .sd-slide.is-entering .sd-escena__product {
      animation: sd-product-in 1.25s var(--sd-ease) 0.4s both;
    }

    .sd-anim .sd-slide.is-leaving .sd-escena__product {
      animation: sd-product-out 0.5s cubic-bezier(0.55, 0, 0.75, 0.1) both;
    }

    .sd-anim .sd-slide.is-entering .sd-escena__info > * {
      animation: sd-info-in 0.8s var(--sd-ease) 0.8s both;
    }

    .sd-anim .sd-slide.is-leaving .sd-escena__info {
      animation: sd-fade-out 0.3s ease both;
    }

    @keyframes sd-line-in {
      from {
        clip-path: inset(100% -5% 0% -5%);
        translate: 0 45%;
      }
      to {
        clip-path: inset(-20% -5% -20% -5%);
        translate: 0 0;
      }
    }

    @keyframes sd-line-out {
      from {
        clip-path: inset(-20% -5% -20% -5%);
        translate: 0 0;
      }
      to {
        clip-path: inset(0% -5% 100% -5%);
        translate: 0 -35%;
      }
    }

    @keyframes sd-product-in {
      from {
        opacity: 0;
        translate: calc(var(--sd-dir, 1) * 24%) 5%;
        rotate: calc(var(--sd-dir, 1) * 10deg);
        scale: 0.84;
      }
      to {
        opacity: 1;
        translate: 0 0;
        rotate: 0deg;
        scale: 1;
      }
    }

    @keyframes sd-product-out {
      to {
        opacity: 0;
        translate: calc(var(--sd-dir, 1) * -18%) -4%;
        rotate: calc(var(--sd-dir, 1) * -8deg);
        scale: 0.9;
      }
    }

    @keyframes sd-info-in {
      from {
        opacity: 0;
        translate: 0 0.75rem;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }

    @keyframes sd-fade-out {
      to {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .sd-anim .sd-slide .sd-escena__word span,
      .sd-anim .sd-slide .sd-escena__product,
      .sd-anim .sd-slide .sd-escena__info,
      .sd-anim .sd-slide .sd-escena__info > * {
        animation: none !important;
      }
    }

    .sd-escena__top {
      position: relative;
      z-index: 5;
      flex-wrap: wrap;
    }

    .sd-nav {
      position: relative;
      display: flex;
      gap: 1.5rem;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .sd-nav::-webkit-scrollbar {
      display: none;
    }

    .sd-nav__item {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5rem;
      flex: none;
      margin: 0;
      padding: 0 0 0.5rem;
      border: 0;
      background: none;
      color: var(--sd-mute);
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      cursor: pointer;
      opacity: 0.6;
      transition: color 0.6s ease, opacity 0.3s ease;
    }

    .sd-nav__item.is-active {
      color: var(--sd-ink);
      opacity: 1;
    }

    .sd-nav__bar {
      position: absolute;
      bottom: 0;
      left: 0;
      width: var(--sd-bar-w, 0);
      height: 1px;
      background: var(--sd-ink);
      translate: var(--sd-bar-x, 0) 0;
      transition: translate 0.7s var(--sd-ease), width 0.7s var(--sd-ease), background-color 0.6s ease;
    }

    @media (hover: hover) {
      .sd-nav__item:hover {
        opacity: 1;
      }
    }

    .sd-nav__item:focus-visible {
      outline: 1px solid var(--sd-ink);
      outline-offset: 4px;
    }

    .sd-nav__n {
      font-variant-numeric: tabular-nums;
    }

    @media screen and (max-width: 749px) {
      .sd-escena__top {
        row-gap: 1.25rem;
      }

      .sd-nav {
        flex-basis: 100%;
        margin-inline: calc(-1 * var(--page-margin, 1.25rem));
        padding-inline: var(--page-margin, 1.25rem);
        max-width: none;
      }
    }

    @media screen and (min-width: 750px) {
      .sd-escena__word {
        align-self: center;
      }

      /* El producto flota sobre las letras: el alto lo marcan las letras, no los
         bordes transparentes del PNG */
      .sd-escena__stage {
        position: relative;
        padding-top: var(--sd-tg, 1rem);
        padding-bottom: 4cqi;
      }

      .sd-escena__product {
        position: absolute;
        top: 50%;
        left: 50%;
        width: var(--sd-size, 62%);
        margin-top: 0;
        transform: translate(-50%, calc(-50% + var(--sd-offset, 0%)));
      }
    }

    @media screen and (min-width: 990px) {
      .sd-escena__inner {
        padding-top: var(--sd-pt, 3rem);
        padding-bottom: clamp(4.5rem, 7vw, 7rem);
      }

      .sd-escena__top {
        margin-bottom: 0;
      }

      .sd-escena__info {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        margin-top: 3.5rem;
        padding-top: 2rem;
      }

      .sd-slide .sd-escena__stage {
        margin-bottom: 3.5rem;
      }

      .sd-escena__buy {
        justify-content: flex-end;
      }
    }
  {% endstyle %}

  {%- if sima_layout == 'escena' -%}
    {%- liquid
      assign sd_first_tone = sima_tone
      if sima_slides.size > 0
        assign sd_t = sima_slides.first.settings.tone
        if sd_t != blank and sd_t != 'seccion'
          assign sd_first_tone = sd_t
        endif
      endif
      assign sd_count = sima_slides.size
      if sd_count == 0
        assign sd_count = 1
      endif
    -%}
    <div
      class="sima-destacado sima-destacado--{{ sd_first_tone }} sima-destacado--escena{% if section.settings.transition != 'none' %} sd-anim{% endif %}"
      data-sd-carousel
      data-section-tone="{{ sima_tone }}"
    >
      <div
        class="sd-escena__inner"
        style="--sd-pt: {{ section.settings.space_top | default: 48 }}px; --sd-pt-m: {{ section.settings.space_top_mobile | default: 32 }}px; --sd-tg: {{ section.settings.space_title | default: 16 }}px;"
      >
        <div class="sd-escena__top">
          <p>{{ section.settings.eyebrow }}</p>
          {%- if sd_count > 1 -%}
            <div class="sd-nav" role="tablist" aria-label="{{ section.settings.eyebrow | default: 'Destacados' | escape }}">
              {%- for block in sima_slides -%}
                {%- liquid
                  assign sd_label = block.settings.index_label
                  if sd_label == blank
                    assign sd_label = block.settings.product.title | default: block.settings.title
                  endif
                -%}
                <button
                  type="button"
                  class="sd-nav__item{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  id="sd-tab-{{ block.id }}"
                  aria-controls="sd-slide-{{ block.id }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  {% unless forloop.first %}tabindex="-1"{% endunless %}
                  data-sd-go="{{ forloop.index0 }}"
                >
                  <span class="sd-nav__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="sd-nav__label">{{ sd_label }}</span>
                </button>
              {%- endfor -%}
              <span class="sd-nav__bar" aria-hidden="true"></span>
            </div>
          {%- elsif section.settings.caption != blank -%}
            <p>{{ section.settings.caption }}</p>
          {%- endif -%}
        </div>

        <div class="sd-slides" data-sd-slides>
          {%- if sima_slides.size > 0 -%}
            {%- for block in sima_slides -%}
              {%- liquid
                assign sd_tone = block.settings.tone
                if sd_tone == blank or sd_tone == 'seccion'
                  assign sd_tone = sima_tone
                endif
                assign sd_attrs = block.shopify_attributes
                assign sd_slide_id = 'sd-slide-' | append: block.id
              -%}
              {%- render 'sima-destacado-slide',
                product: block.settings.product,
                cutout: block.settings.cutout,
                title: block.settings.title,
                title_outline: block.settings.title_outline,
                text: block.settings.text,
                button_label: block.settings.button_label,
                size: block.settings.product_size,
                size_m: block.settings.product_size_mobile,
                offset: block.settings.product_offset,
                offset_m: block.settings.product_offset_mobile,
                gap: section.settings.line_gap,
                outline_front: block.settings.outline_front,
                tone: sd_tone,
                index: forloop.index0,
                active: forloop.first,
                slide_id: sd_slide_id,
                attrs: sd_attrs
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- render 'sima-destacado-slide',
              product: sima_product,
              cutout: sima_cutout,
              title: section.settings.title,
              title_outline: section.settings.title_outline,
              text: section.settings.text,
              button_label: section.settings.button_label,
              size: section.settings.product_size,
              size_m: section.settings.product_size_mobile,
              offset: section.settings.product_offset,
              offset_m: section.settings.product_offset_mobile,
              gap: section.settings.line_gap,
              outline_front: section.settings.outline_front,
              tone: sima_tone,
              index: 0,
              active: true,
              slide_id: 'sd-slide-single'
            -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if sd_count > 1 -%}
      <script>
        (() => {
          const root = document.querySelector('#shopify-section-{{ section.id }} [data-sd-carousel]');
          if (!root) return;
          const slides = [...root.querySelectorAll('.sd-slide')];
          const tabs = [...root.querySelectorAll('[data-sd-go]')];
          const nav = root.querySelector('.sd-nav');
          const bar = root.querySelector('.sd-nav__bar');
          const area = root.querySelector('[data-sd-slides]');
          const tones = ['blanco', 'crema', 'oscuro'];
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
          const animated = () => root.classList.contains('sd-anim') && !reduce.matches;
          const toneOf = (s) => s.dataset.tone || root.dataset.sectionTone || 'blanco';
          const bgOf = (s) => getComputedStyle(s).getPropertyValue('--sd-bg').trim();
          let current = slides.findIndex((s) => s.classList.contains('is-active'));
          if (current < 0) current = 0;
          let cleanup = null;

          const setTone = (tone) => tones.forEach((t) => root.classList.toggle('sima-destacado--' + t, t === tone));

          const placeBar = () => {
            const tab = tabs[current];
            if (!tab || !bar) return;
            root.style.setProperty('--sd-bar-x', tab.offsetLeft + 'px');
            root.style.setProperty('--sd-bar-w', tab.offsetWidth + 'px');
          };

          const finish = () => {
            if (cleanup) cleanup();
            cleanup = null;
          };

          const go = (i, dir, focusTab) => {
            const n = slides.length;
            i = ((i % n) + n) % n;
            if (i === current) return;
            finish();
            const prev = slides[current];
            const next = slides[i];
            dir = dir || (i > current ? 1 : -1);
            current = i;

            slides.forEach((s) => {
              const on = s === next;
              s.classList.toggle('is-active', on);
              s.classList.remove('is-entering', 'is-leaving');
              if (on) s.removeAttribute('aria-hidden');
              else s.setAttribute('aria-hidden', 'true');
              s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
            });
            tabs.forEach((t, k) => {
              const on = k === i;
              t.classList.toggle('is-active', on);
              t.setAttribute('aria-selected', on ? 'true' : 'false');
              t.tabIndex = on ? 0 : -1;
            });
            const tab = tabs[i];
            if (tab && nav) {
              nav.scrollTo({ left: tab.offsetLeft - (nav.clientWidth - tab.offsetWidth) / 2, behavior: animated() ? 'smooth' : 'auto' });
              if (focusTab) tab.focus({ preventScroll: true });
            }
            placeBar();

            const newTone = toneOf(next);
            if (!animated()) {
              setTone(newTone);
              root.style.removeProperty('--sd-stage-bg');
              return;
            }

            root.style.setProperty('--sd-dir', dir);
            prev.classList.add('is-leaving');
            next.classList.add('is-entering');

            // El color nuevo se abre en círculo desde el centro del producto
            const oldBg = bgOf(prev);
            const newBg = bgOf(next);
            let fx = null;
            let toneTimer = null;
            if (oldBg !== newBg) {
              const rr = root.getBoundingClientRect();
              const stage = next.querySelector('.sd-escena__stage').getBoundingClientRect();
              const x = stage.left + stage.width / 2 - rr.left;
              const y = stage.top + stage.height / 2 - rr.top;
              const r = Math.hypot(Math.max(x, rr.width - x), Math.max(y, rr.height - y));
              root.style.setProperty('--sd-stage-bg', oldBg);
              fx = document.createElement('div');
              fx.className = 'sd-bgfx';
              fx.style.background = newBg;
              root.prepend(fx);
              fx.animate(
                [{ clipPath: `circle(0px at ${x}px ${y}px)` }, { clipPath: `circle(${r}px at ${x}px ${y}px)` }],
                { duration: 1000, delay: 60, easing: 'cubic-bezier(0.6, 0, 0.2, 1)', fill: 'both' }
              );
              toneTimer = setTimeout(() => setTone(newTone), 450);
            } else {
              setTone(newTone);
            }

            const timer = setTimeout(finish, 2000);
            cleanup = () => {
              clearTimeout(timer);
              clearTimeout(toneTimer);
              setTone(newTone);
              root.style.removeProperty('--sd-stage-bg');
              if (fx) fx.remove();
              prev.classList.remove('is-leaving');
              next.classList.remove('is-entering');
            };
          };

          tabs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.sdGo))));
          nav?.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') { e.preventDefault(); go(current + 1, 1, true); }
            if (e.key === 'ArrowLeft') { e.preventDefault(); go(current - 1, -1, true); }
          });

          // Deslizar en celular: solo cambia cuando el gesto es claramente horizontal
          let x0 = null, y0 = null;
          area.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
          area.addEventListener('touchend', (e) => {
            if (x0 === null) return;
            const dx = e.changedTouches[0].clientX - x0;
            const dy = e.changedTouches[0].clientY - y0;
            x0 = y0 = null;
            if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
              const d = dx < 0 ? 1 : -1;
              go(current + d, d);
            }
          });

          // En el editor de temas, seleccionar un producto muestra su escena
          document.addEventListener('shopify:block:select', (e) => {
            const i = slides.findIndex((s) => s.id === 'sd-slide-' + e.detail.blockId);
            if (i > -1) go(i);
          });

          placeBar();
          window.addEventListener('resize', placeBar);
          if (document.fonts) document.fonts.ready.then(placeBar);
        })();
      </script>
    {%- endif -%}
  {%- else -%}
  <div
    class="sima-destacado sima-destacado--{{ sima_tone }}{% if section.settings.reverse %} sima-destacado--reverse{% endif %}"
  >
    <div class="sima-destacado__inner">
      <figure class="sima-destacado__figure">
        <a class="sima-destacado__frame" href="{{ sima_product.url }}" tabindex="-1" aria-hidden="true">
          {%- if sima_img != blank -%}
            {{
              sima_img
              | image_url: width: 1800
              | image_tag:
                class: 'sima-destacado__media',
                widths: '600, 900, 1200, 1500, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: sima_product.title,
                style: sima_pos
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'sima-destacado__media' }}
          {%- endif -%}
        </a>
        {%- if section.settings.caption != blank -%}
          <figcaption class="sima-destacado__caption">{{ section.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>

      <div class="sima-destacado__body">
        <div class="sima-destacado__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sima-destacado__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="sima-destacado__title">
          {%- if sima_first != blank -%}
            <span>{{ sima_first }}</span>
          {%- endif -%}
          <span class="is-stroke">{{ sima_last }}</span>
        </h2>
        </div>

        <div class="sima-destacado__foot">

        {%- if section.settings.text != blank -%}
          <p class="sima-destacado__text">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sima-destacado__specs" role="list">
            {%- for block in section.blocks -%}
              <li class="sima-destacado__spec" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="sima-destacado__buy">
          <p class="sima-destacado__price">
            {%- if sima_product.compare_at_price > sima_product.price -%}
              <s>{{ sima_product.compare_at_price | money }}</s>
            {%- endif -%}
            <span>{{ sima_product.price | money }}</span>
          </p>
          <a class="sima-destacado__cta" href="{{ sima_product.url }}">
            {{- section.settings.button_label | default: 'Ver producto' -}}
          </a>
        </div>

        {%- if section.settings.note != blank -%}
          <p class="sima-destacado__note">{{ section.settings.note }}</p>
        {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "SIMA — Destacado",
  "tag": "section",
  "class": "sima-destacado-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Producto destacado debajo del hero. Sale solo en la colección cuyo handle va en «Colección padre». La segunda línea del título va en contorno."
    },
    {
      "type": "text",
      "id": "parent",
      "label": "Colección padre (handle)",
      "default": "tecnologia"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Composición",
      "options": [
        { "value": "dividida", "label": "Dividida: foto y texto" },
        { "value": "escena", "label": "Escena: producto entre las letras" }
      ],
      "default": "dividida",
      "info": "Escena necesita la imagen del producto sin fondo."
    },
    {
      "type": "image_picker",
      "id": "cutout",
      "label": "Producto sin fondo (Escena)",
      "info": "PNG con fondo transparente."
    },
    {
      "type": "range",
      "id": "product_size",
      "label": "Tamaño del producto en computador (Escena)",
      "min": 25,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 62
    },
    {
      "type": "range",
      "id": "product_size_mobile",
      "label": "Tamaño del producto en celular (Escena)",
      "min": 40,
      "max": 120,
      "step": 2,
      "unit": "%",
      "default": 84
    },
    {
      "type": "range",
      "id": "product_offset",
      "label": "Altura del producto (Escena)",
      "min": -30,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 0,
      "info": "Negativo lo sube, positivo lo baja."
    },
    {
      "type": "range",
      "id": "product_offset_mobile",
      "label": "Altura del producto en celular (Escena)",
      "min": -10,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 8,
      "info": "Distancia desde arriba. Más alto deja leer mejor el nombre."
    },
    {
      "type": "range",
      "id": "line_gap",
      "label": "Separación entre las dos líneas (Escena)",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Espacio arriba en computador (Escena)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "space_top_mobile",
      "label": "Espacio arriba en celular (Escena)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "space_title",
      "label": "Espacio entre «Destacado» y el título en computador (Escena)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Cambio entre productos (Escena)",
      "options": [
        { "value": "anim", "label": "Animado" },
        { "value": "none", "label": "Instantáneo" }
      ],
      "default": "anim"
    },
    {
      "type": "checkbox",
      "id": "outline_front",
      "label": "Contorno por delante del producto (Escena)",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Vacío usa la foto principal del producto. Cuadrada, 1800 px o más."
    },
    {
      "type": "text",
      "id": "image_position",
      "label": "Encuadre de la imagen",
      "info": "Ej.: center, 60% 40%"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Retrato 4:5" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo",
      "options": [
        { "value": "blanco", "label": "Blanco" },
        { "value": "crema", "label": "Crema" },
        { "value": "oscuro", "label": "Oscuro" }
      ],
      "default": "blanco"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Foto a la derecha",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Destacado"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "info": "Vacío usa el nombre del producto"
    },
    {
      "type": "text",
      "id": "title_outline",
      "label": "Segunda línea en contorno",
      "info": "Ej.: Pro 3. Vacío pone en contorno la última palabra del título."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Frase"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver producto"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Pie de foto",
      "info": "Texto pequeño debajo de la foto. Vacío lo oculta."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota bajo el botón",
      "info": "Vacío la oculta."
    }
  ],
  "blocks": [
    {
      "type": "escena",
      "name": "Producto (Escena)",
      "limit": 8,
      "settings": [
        {
          "type": "paragraph",
          "content": "Con dos o más productos la sección es un carrusel con índice. Sin productos aquí, usa el producto de la sección."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "image_picker",
          "id": "cutout",
          "label": "Producto sin fondo",
          "info": "PNG con fondo transparente, recortado justo al borde del producto."
        },
        {
          "type": "text",
          "id": "index_label",
          "label": "Nombre en el índice",
          "info": "Vacío usa el nombre del producto"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Primera línea",
          "info": "Vacío usa el nombre del producto"
        },
        {
          "type": "text",
          "id": "title_outline",
          "label": "Segunda línea en contorno",
          "info": "Vacío pone en contorno la última palabra"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Frase"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón",
          "default": "Ver producto"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Fondo",
          "options": [
            { "value": "seccion", "label": "El de la sección" },
            { "value": "blanco", "label": "Blanco" },
            { "value": "crema", "label": "Crema" },
            { "value": "oscuro", "label": "Oscuro" }
          ],
          "default": "seccion",
          "info": "Un producto negro se ve mejor en Oscuro."
        },
        {
          "type": "range",
          "id": "product_size",
          "label": "Tamaño en computador",
          "min": 25,
          "max": 80,
          "step": 1,
          "unit": "%",
          "default": 62
        },
        {
          "type": "range",
          "id": "product_size_mobile",
          "label": "Tamaño en celular",
          "min": 40,
          "max": 120,
          "step": 2,
          "unit": "%",
          "default": 84
        },
        {
          "type": "range",
          "id": "product_offset",
          "label": "Altura en computador",
          "min": -30,
          "max": 30,
          "step": 1,
          "unit": "%",
          "default": 0,
          "info": "Negativo lo sube, positivo lo baja."
        },
        {
          "type": "range",
          "id": "product_offset_mobile",
          "label": "Altura en celular",
          "min": -10,
          "max": 40,
          "step": 1,
          "unit": "%",
          "default": 8
        },
        {
          "type": "checkbox",
          "id": "outline_front",
          "label": "Contorno por delante del producto",
          "default": true
        }
      ]
    },
    {
      "type": "spec",
      "name": "Característica",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIMA — Destacado"
    }
  ]
}
{% endschema %}
