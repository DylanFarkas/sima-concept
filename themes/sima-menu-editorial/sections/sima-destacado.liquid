{%- liquid
  assign sima_product = section.settings.product
  assign sima_show = false
  if sima_product != blank and section.settings.parent != blank and collection.handle == section.settings.parent
    assign sima_show = true
  endif
-%}

{%- if sima_show -%}
  {%- liquid
    assign sima_img = section.settings.image
    if sima_img == blank
      assign sima_img = sima_product.featured_image
    endif

    assign sima_title = section.settings.title | default: sima_product.title | strip
    assign sima_words = sima_title | split: ' '
    assign sima_last = sima_words | last
    assign sima_first = sima_title | remove_last: sima_last | strip
    if section.settings.title_outline != blank
      assign sima_first = sima_title
      assign sima_last = section.settings.title_outline
    endif

    assign sima_pos = section.settings.image_position | default: 'center' | prepend: 'object-position: '
    assign sima_tone = section.settings.tone | default: 'blanco'
  -%}

  {% style %}
    .sima-destacado {
      --sd-bg: #fff;
      --sd-ink: #121212;
      --sd-mute: rgb(18 18 18 / 0.55);
      --sd-line: rgb(18 18 18 / 0.1);
      --sd-frame: #f4f4f2;
      --sd-stroke: #121212;
      --sd-btn-bg: #121212;
      --sd-btn-fg: #fff;
      --sd-ease: cubic-bezier(0.16, 1, 0.3, 1);
      display: block;
      background: var(--sd-bg);
      color: var(--sd-ink);
    }

    .sima-destacado--crema {
      --sd-bg: #f2efe9;
      --sd-frame: #e8e4dc;
    }

    .sima-destacado--oscuro {
      --sd-bg: #121212;
      --sd-ink: #fff;
      --sd-mute: rgb(255 255 255 / 0.58);
      --sd-line: rgb(255 255 255 / 0.12);
      --sd-frame: #1a1a1a;
      --sd-stroke: #bcb1a6;
      --sd-btn-bg: #fff;
      --sd-btn-fg: #121212;
    }

    .sima-destacado__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
      max-width: var(--page-width, 120rem);
      margin-inline: auto;
      padding: 4rem var(--page-margin, 1.25rem) 4.5rem;
    }

    .sima-destacado__figure {
      margin: 0;
    }

    .sima-destacado__frame {
      position: relative;
      display: block;
      aspect-ratio: {{ section.settings.ratio | default: '1' }};
      overflow: hidden;
      background: var(--sd-frame);
    }

    .sima-destacado__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .sima-destacado__caption {
      margin-top: 0.875rem;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .sima-destacado__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-width: 0;
    }

    .sima-destacado__eyebrow {
      margin: 0 0 1.75rem;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      line-height: 1;
      text-transform: uppercase;
    }

    .sima-destacado__title {
      margin: 0;
      color: var(--sd-ink);
      font-family: var(--font-heading--family);
      font-size: clamp(3rem, 14vw, 4.5rem);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .sima-destacado__title span {
      display: block;
    }

    .sima-destacado__title .is-stroke {
      color: transparent;
      -webkit-text-stroke: 1.25px var(--sd-stroke);
    }

    .sima-destacado__text {
      max-width: 32ch;
      margin: 1.75rem 0 0;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.9375rem;
      line-height: 1.65;
      text-wrap: pretty;
    }

    .sima-destacado__specs {
      width: 100%;
      max-width: 24rem;
      margin: 2rem 0 0;
      padding: 0;
      list-style: none;
    }

    .sima-destacado__spec {
      padding-block: 0.75rem;
      border-top: 1px solid var(--sd-line);
      color: var(--sd-ink);
      font-family: var(--font-body--family);
      font-size: 0.8125rem;
      line-height: 1.45;
    }

    .sima-destacado__buy {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem 1.5rem;
      width: 100%;
      max-width: 24rem;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--sd-line);
    }

    .sima-destacado__price {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
      margin: 0;
      font-family: var(--font-heading--family);
      font-size: 1.375rem;
      font-weight: 700;
      line-height: 1;
    }

    .sima-destacado__price s {
      color: var(--sd-mute);
      font-size: 0.9375rem;
      font-weight: 500;
    }

    .sima-destacado__cta {
      display: inline-flex;
      align-items: center;
      padding: 1rem 1.625rem;
      background: var(--sd-btn-bg);
      color: var(--sd-btn-fg);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      line-height: 1;
      text-decoration: none;
      text-transform: uppercase;
      transition: opacity 200ms ease, transform 120ms var(--sd-ease);
    }

    @media (hover: hover) {
      .sima-destacado__cta:hover {
        opacity: 0.85;
      }
    }

    .sima-destacado__cta:active {
      transform: scale(0.97);
    }

    .sima-destacado .sima-destacado__cta::after {
      content: none !important;
      display: none !important;
      animation: none !important;
    }

    .sima-destacado__cta:focus-visible {
      outline: 2px solid var(--sd-ink);
      outline-offset: 3px;
    }

    .sima-destacado__note {
      margin: 1rem 0 0;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.75rem;
      line-height: 1.4;
    }

    /* Entrada al hacer scroll: fundido suave, sin movimiento en la foto */
    .sima-destacado.is-armed .sima-destacado__figure,
    .sima-destacado.is-armed .sima-destacado__reveal {
      opacity: 0;
      transition: opacity 1.1s var(--sd-ease), transform 1.1s var(--sd-ease);
    }

    .sima-destacado.is-armed .sima-destacado__reveal {
      transform: translateY(0.75rem);
      transition-delay: calc(0.2s + var(--sd-i, 0) * 0.07s);
    }

    .sima-destacado.is-armed.is-in .sima-destacado__figure,
    .sima-destacado.is-armed.is-in .sima-destacado__reveal {
      opacity: 1;
      transform: none;
    }

    .sima-destacado__head,
    .sima-destacado__foot {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    /* El tema anula el margen superior del primer hijo: el aire va en el contenedor */
    .sima-destacado__foot {
      padding-top: 1.75rem;
    }

    .sima-destacado__foot > :first-child {
      margin-top: 0;
    }

    /* Celular: titulo arriba, foto a sangre en medio, frase y compra debajo */
    @media screen and (max-width: 989px) {
      .sima-destacado__inner {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding-block: 3.5rem 4rem;
      }

      .sima-destacado__body {
        display: contents;
      }

      .sima-destacado__head {
        order: 1;
      }

      .sima-destacado__figure {
        order: 2;
        margin: 1.75rem calc(-1 * var(--page-margin, 1.25rem)) 0;
      }

      .sima-destacado__foot {
        order: 3;
        padding-top: 1.5rem;
      }

      .sima-destacado__eyebrow {
        margin-bottom: 0.875rem;
      }

      .sima-destacado__title {
        font-size: clamp(2.5rem, 11.5vw, 3.75rem);
        line-height: 0.95;
      }

      .sima-destacado__title span {
        display: inline;
      }

      .sima-destacado__title span + span {
        margin-left: 0.22em;
      }

      .sima-destacado__caption {
        padding-inline: var(--page-margin, 1.25rem);
      }

      .sima-destacado__text {
        max-width: 36ch;
      }

      .sima-destacado__specs,
      .sima-destacado__buy {
        max-width: none;
      }

      .sima-destacado__buy {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
      }
    }

    @media screen and (min-width: 990px) {
      .sima-destacado__inner {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: center;
        gap: 0 clamp(1.5rem, 2.5vw, 3rem);
        padding-block: clamp(6rem, 10vw, 10rem);
      }

      .sima-destacado__figure {
        grid-column: 1 / span 6;
      }

      .sima-destacado__body {
        grid-column: 8 / span 5;
      }

      .sima-destacado--reverse .sima-destacado__figure {
        grid-column: 7 / span 6;
        grid-row: 1;
      }

      .sima-destacado--reverse .sima-destacado__body {
        grid-column: 1 / span 5;
        grid-row: 1;
      }

      .sima-destacado__title {
        font-size: clamp(4rem, 5.8vw, 6.25rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .sima-destacado.is-armed .sima-destacado__figure,
      .sima-destacado.is-armed .sima-destacado__reveal {
        transition: none;
        opacity: 1;
        transform: none;
      }
    }
  {% endstyle %}

  <div
    class="sima-destacado sima-destacado--{{ sima_tone }}{% if section.settings.reverse %} sima-destacado--reverse{% endif %}"
    data-sima-destacado
  >
    <div class="sima-destacado__inner">
      <figure class="sima-destacado__figure">
        <a class="sima-destacado__frame" href="{{ sima_product.url }}" tabindex="-1" aria-hidden="true">
          {%- if sima_img != blank -%}
            {{
              sima_img
              | image_url: width: 1800
              | image_tag:
                class: 'sima-destacado__media',
                widths: '600, 900, 1200, 1500, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: sima_product.title,
                style: sima_pos
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'sima-destacado__media' }}
          {%- endif -%}
        </a>
        {%- if section.settings.caption != blank -%}
          <figcaption class="sima-destacado__caption">{{ section.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>

      <div class="sima-destacado__body">
        <div class="sima-destacado__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sima-destacado__eyebrow sima-destacado__reveal" style="--sd-i: 0">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="sima-destacado__title sima-destacado__reveal" style="--sd-i: 1">
          {%- if sima_first != blank -%}
            <span>{{ sima_first }}</span>
          {%- endif -%}
          <span class="is-stroke">{{ sima_last }}</span>
        </h2>
        </div>

        <div class="sima-destacado__foot">

        {%- if section.settings.text != blank -%}
          <p class="sima-destacado__text sima-destacado__reveal" style="--sd-i: 2">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sima-destacado__specs sima-destacado__reveal" style="--sd-i: 3" role="list">
            {%- for block in section.blocks -%}
              <li class="sima-destacado__spec" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="sima-destacado__buy sima-destacado__reveal" style="--sd-i: 4">
          <p class="sima-destacado__price">
            {%- if sima_product.compare_at_price > sima_product.price -%}
              <s>{{ sima_product.compare_at_price | money }}</s>
            {%- endif -%}
            <span>{{ sima_product.price | money }}</span>
          </p>
          <a class="sima-destacado__cta" href="{{ sima_product.url }}">
            {{- section.settings.button_label | default: 'Ver producto' -}}
          </a>
        </div>

        {%- if section.settings.note != blank -%}
          <p class="sima-destacado__note sima-destacado__reveal" style="--sd-i: 5">{{ section.settings.note }}</p>
        {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector('#shopify-section-{{ section.id }} [data-sima-destacado]');
      if (!root || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.Shopify && Shopify.designMode) return;
      if (root.getBoundingClientRect().top < window.innerHeight * 0.85) return;
      root.classList.add('is-armed');
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          root.classList.add('is-in');
          io.disconnect();
        }
      }, { threshold: 0.2 });
      io.observe(root);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SIMA — Destacado",
  "tag": "section",
  "class": "sima-destacado-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Producto destacado debajo del hero. Sale solo en la colección cuyo handle va en «Colección padre». La segunda línea del título va en contorno."
    },
    {
      "type": "text",
      "id": "parent",
      "label": "Colección padre (handle)",
      "default": "tecnologia"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Vacío usa la foto principal del producto. Cuadrada, 1800 px o más."
    },
    {
      "type": "text",
      "id": "image_position",
      "label": "Encuadre de la imagen",
      "info": "Ej.: center, 60% 40%"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Retrato 4:5" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo",
      "options": [
        { "value": "blanco", "label": "Blanco" },
        { "value": "crema", "label": "Crema" },
        { "value": "oscuro", "label": "Oscuro" }
      ],
      "default": "blanco"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Foto a la derecha",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Destacado"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "info": "Vacío usa el nombre del producto"
    },
    {
      "type": "text",
      "id": "title_outline",
      "label": "Segunda línea en contorno",
      "info": "Ej.: Pro 3. Vacío pone en contorno la última palabra del título."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Frase"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver producto"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Pie de foto",
      "info": "Texto pequeño debajo de la foto. Vacío lo oculta."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota bajo el botón",
      "info": "Vacío la oculta."
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Característica",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIMA — Destacado"
    }
  ]
}
{% endschema %}
