{%- liquid
  assign sima_product = section.settings.product
  assign sima_show = false
  if sima_product != blank and section.settings.parent != blank and collection.handle == section.settings.parent
    assign sima_show = true
  endif
-%}

{%- if sima_show -%}
  {%- liquid
    assign sima_img = section.settings.image
    if sima_img == blank
      assign sima_img = sima_product.featured_image
    endif

    assign sima_title = section.settings.title | default: sima_product.title | strip
    assign sima_words = sima_title | split: ' '
    assign sima_last = sima_words | last
    assign sima_first = sima_title | remove_last: sima_last | strip
    if section.settings.title_outline != blank
      assign sima_first = sima_title
      assign sima_last = section.settings.title_outline
    endif

    assign sima_pos = section.settings.image_position | default: 'center' | prepend: 'object-position: '
    assign sima_tone = section.settings.tone | default: 'crema'
  -%}

  {% style %}
    .sima-destacado {
      --sd-bg: #f2efe9;
      --sd-ink: #121212;
      --sd-mute: rgb(18 18 18 / 0.58);
      --sd-line: rgb(18 18 18 / 0.14);
      --sd-btn-bg: #121212;
      --sd-btn-fg: #fff;
      --sd-ease: cubic-bezier(0.16, 1, 0.3, 1);
      display: block;
      background: var(--sd-bg);
      color: var(--sd-ink);
    }

    .sima-destacado--oscuro {
      --sd-bg: #121212;
      --sd-ink: #fff;
      --sd-mute: rgb(255 255 255 / 0.6);
      --sd-line: rgb(255 255 255 / 0.14);
      --sd-btn-bg: #fff;
      --sd-btn-fg: #121212;
    }

    .sima-destacado__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      max-width: var(--page-width, 120rem);
      margin-inline: auto;
      padding: 4.5rem var(--page-margin, 1.25rem) 5rem;
    }

    /* Foto */
    .sima-destacado__figure {
      position: relative;
      margin: 0;
    }

    .sima-destacado__frame {
      position: relative;
      display: block;
      aspect-ratio: {{ section.settings.ratio | default: '1' }};
      overflow: hidden;
      background: #1a1a1a;
      color: inherit;
    }

    .sima-destacado__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.001);
      transition: transform 1.6s var(--sd-ease);
    }

    @media (hover: hover) {
      .sima-destacado__frame:hover .sima-destacado__media {
        transform: scale(1.035);
      }
    }

    .sima-destacado__caption {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 0.875rem;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    /* Texto */
    .sima-destacado__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-width: 0;
    }

    .sima-destacado__eyebrow {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      margin: 0 0 1.5rem;
      color: var(--sd-mute);
      font-family: var(--font-heading--family);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.24em;
      line-height: 1;
      text-transform: uppercase;
    }

    .sima-destacado__eyebrow::before {
      content: '';
      width: 2.25rem;
      height: 1px;
      background: currentColor;
    }

    .sima-destacado__title {
      margin: 0;
      color: var(--sd-ink);
      font-family: var(--font-heading--family);
      font-size: clamp(3.25rem, 15vw, 5rem);
      font-weight: 700;
      line-height: 0.88;
      letter-spacing: -0.005em;
      text-transform: uppercase;
    }

    .sima-destacado__title span {
      display: block;
    }

    .sima-destacado__title .is-stroke {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--sd-ink);
      transition: color 0.5s var(--sd-ease);
    }

    @media (hover: hover) {
      .sima-destacado__body:hover .sima-destacado__title .is-stroke {
        color: var(--sd-ink);
      }
    }

    .sima-destacado--oscuro .sima-destacado__title .is-stroke {
      -webkit-text-stroke-color: #bcb1a6;
    }

    .sima-destacado__text {
      max-width: 34ch;
      margin: 1.75rem 0 0;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.9375rem;
      line-height: 1.6;
      text-wrap: pretty;
    }

    .sima-destacado__specs {
      width: 100%;
      max-width: 26rem;
      margin: 2rem 0 0;
      padding: 0;
      border-top: 1px solid var(--sd-line);
      list-style: none;
    }

    .sima-destacado__spec {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.75rem;
      padding-block: 0.875rem;
      border-bottom: 1px solid var(--sd-line);
      font-family: var(--font-body--family);
      font-size: 0.8125rem;
      line-height: 1.4;
    }

    .sima-destacado__spec-n {
      color: var(--sd-mute);
      font-family: var(--font-heading--family);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    .sima-destacado__buy {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.75rem;
      margin-top: 2.25rem;
    }

    .sima-destacado__price {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
      font-family: var(--font-heading--family);
      font-size: 1.625rem;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.01em;
    }

    .sima-destacado__price s {
      color: var(--sd-mute);
      font-size: 1rem;
      font-weight: 500;
    }

    .sima-destacado__cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1.0625rem 1.75rem;
      background: var(--sd-btn-bg);
      color: var(--sd-btn-fg);
      font-family: var(--font-body--family);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      line-height: 1;
      text-decoration: none;
      text-transform: uppercase;
      transition: transform 120ms var(--sd-ease);
    }

    .sima-destacado__cta svg {
      width: 0.875rem;
      height: 0.875rem;
      transition: transform 0.4s var(--sd-ease);
    }

    @media (hover: hover) {
      .sima-destacado__cta:hover svg {
        transform: translateX(0.25rem);
      }
    }

    .sima-destacado__cta:active {
      transform: scale(0.97);
    }

    .sima-destacado .sima-destacado__cta::after {
      content: none !important;
      display: none !important;
      animation: none !important;
    }

    .sima-destacado__cta:focus-visible {
      outline: 2px solid var(--sd-ink);
      outline-offset: 3px;
    }

    .sima-destacado__note {
      margin: 1.25rem 0 0;
      color: var(--sd-mute);
      font-family: var(--font-body--family);
      font-size: 0.75rem;
      line-height: 1.4;
    }

    /* Entrada al hacer scroll */
    .sima-destacado.is-armed .sima-destacado__frame {
      clip-path: inset(0 0 100% 0);
      transition: clip-path 1.2s var(--sd-ease);
    }

    .sima-destacado.is-armed .sima-destacado__reveal {
      opacity: 0;
      transform: translateY(1.25rem);
      transition:
        opacity 0.9s var(--sd-ease),
        transform 0.9s var(--sd-ease);
      transition-delay: calc(0.25s + var(--sd-i, 0) * 0.08s);
    }

    .sima-destacado.is-armed.is-in .sima-destacado__frame {
      clip-path: inset(0 0 0 0);
    }

    .sima-destacado.is-armed.is-in .sima-destacado__reveal {
      opacity: 1;
      transform: none;
    }

    @media screen and (min-width: 990px) {
      .sima-destacado__inner {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        align-items: center;
        gap: 0 clamp(2rem, 3vw, 3.5rem);
        padding-block: clamp(6rem, 9vw, 9rem);
      }

      .sima-destacado__figure {
        grid-column: 1 / span 7;
      }

      .sima-destacado__body {
        grid-column: 8 / span 5;
        padding-left: clamp(0rem, 2vw, 2.5rem);
      }

      .sima-destacado--reverse .sima-destacado__figure {
        grid-column: 6 / span 7;
        grid-row: 1;
      }

      .sima-destacado--reverse .sima-destacado__body {
        grid-column: 1 / span 5;
        grid-row: 1;
        padding-left: 0;
      }

      .sima-destacado__title {
        font-size: clamp(4.5rem, 7.2vw, 7.5rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .sima-destacado *,
      .sima-destacado.is-armed .sima-destacado__frame,
      .sima-destacado.is-armed .sima-destacado__reveal {
        transition: none !important;
        clip-path: none !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  {% endstyle %}

  <div
    class="sima-destacado sima-destacado--{{ sima_tone }}{% if section.settings.reverse %} sima-destacado--reverse{% endif %}"
    data-sima-destacado
  >
    <div class="sima-destacado__inner">
      <figure class="sima-destacado__figure">
        <a class="sima-destacado__frame" href="{{ sima_product.url }}" tabindex="-1" aria-hidden="true">
          {%- if sima_img != blank -%}
            {{
              sima_img
              | image_url: width: 1800
              | image_tag:
                class: 'sima-destacado__media',
                widths: '600, 900, 1200, 1500, 1800',
                sizes: '(min-width: 990px) 58vw, 100vw',
                loading: 'lazy',
                alt: sima_product.title,
                style: sima_pos
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'sima-destacado__media' }}
          {%- endif -%}
        </a>
        {%- if section.settings.caption != blank -%}
          <figcaption class="sima-destacado__caption">
            <span>{{ section.settings.caption }}</span>
            <span>{{ sima_product.title }}</span>
          </figcaption>
        {%- endif -%}
      </figure>

      <div class="sima-destacado__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sima-destacado__eyebrow sima-destacado__reveal" style="--sd-i: 0">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="sima-destacado__title sima-destacado__reveal" style="--sd-i: 1">
          {%- if sima_first != blank -%}
            <span>{{ sima_first }}</span>
          {%- endif -%}
          <span class="is-stroke">{{ sima_last }}</span>
        </h2>

        {%- if section.settings.text != blank -%}
          <p class="sima-destacado__text sima-destacado__reveal" style="--sd-i: 2">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sima-destacado__specs sima-destacado__reveal" style="--sd-i: 3" role="list">
            {%- for block in section.blocks -%}
              <li class="sima-destacado__spec" {{ block.shopify_attributes }}>
                <span class="sima-destacado__spec-n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="sima-destacado__buy sima-destacado__reveal" style="--sd-i: 4">
          <p class="sima-destacado__price">
            {%- if sima_product.compare_at_price > sima_product.price -%}
              <s>{{ sima_product.compare_at_price | money }}</s>
            {%- endif -%}
            <span>{{ sima_product.price | money }}</span>
          </p>
          <a class="sima-destacado__cta" href="{{ sima_product.url }}">
            {{ section.settings.button_label | default: 'Ver producto' }}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </a>
        </div>

        {%- if section.settings.note != blank -%}
          <p class="sima-destacado__note sima-destacado__reveal" style="--sd-i: 5">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector('#shopify-section-{{ section.id }} [data-sima-destacado]');
      if (!root || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.Shopify && Shopify.designMode) return;
      const rect = root.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.85) return;
      root.classList.add('is-armed');
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          root.classList.add('is-in');
          io.disconnect();
        }
      }, { threshold: 0.2 });
      io.observe(root);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SIMA — Destacado",
  "tag": "section",
  "class": "sima-destacado-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Producto destacado debajo del hero. Sale solo en la colección cuyo handle va en «Colección padre». La última palabra del título va en contorno."
    },
    {
      "type": "text",
      "id": "parent",
      "label": "Colección padre (handle)",
      "default": "tecnologia"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Vacío usa la foto principal del producto. Cuadrada, 1800 px o más."
    },
    {
      "type": "text",
      "id": "image_position",
      "label": "Encuadre de la imagen",
      "info": "Ej.: center, 60% 40%"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Retrato 4:5" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo",
      "options": [
        { "value": "crema", "label": "Crema" },
        { "value": "oscuro", "label": "Oscuro" }
      ],
      "default": "crema"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Foto a la derecha",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Destacado"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "info": "Vacío usa el nombre del producto"
    },
    {
      "type": "text",
      "id": "title_outline",
      "label": "Segunda línea en contorno",
      "info": "Ej.: Pro 3. Vacío pone en contorno la última palabra del título."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Frase"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver producto"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Pie de foto",
      "info": "Texto pequeño debajo de la foto. Vacío lo oculta."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota bajo el botón"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Característica",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIMA — Destacado"
    }
  ]
}
{% endschema %}
