{% liquid
  assign href = section.settings.link
  assign message = section.settings.message | strip
  if message != blank
    assign encoded = message | url_encode
    if href contains '?'
      assign href = href | append: '&text=' | append: encoded
    else
      assign href = href | append: '?text=' | append: encoded
    endif
  endif
%}

{% if section.settings.enabled and href != blank %}
  <a
    class="sima-asesoria"
    href="{{ href }}"
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg class="sima-asesoria__icon" viewBox="-0.4 -0.4 24.8 24.8" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
    </svg>
    <span class="sima-asesoria__label">{{ section.settings.label }}</span>
  </a>
{% endif %}

{% stylesheet %}
  .sima-asesoria-section {
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: visible;
  }

  .sima-asesoria {
    position: fixed;
    z-index: var(--layer-heightened);
    right: 1.25rem;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: #121212;
    color: #fff;
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.28), 0 0 0 1px rgb(255 255 255 / 0.18);
    text-decoration: none;
  }

  .sima-asesoria__icon {
    width: 1.7rem;
    height: 1.7rem;
    overflow: visible;
  }

  .sima-asesoria__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sima-asesoria:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 5px #121212;
  }

  @media screen and (max-width: 749px) {
    body:has(.sticky-add-to-cart__bar[data-stuck='true']) .sima-asesoria {
      bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sima-asesoria {
      transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sima-asesoria:active {
      transform: scale(0.96);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SIMA — Asesoría",
  "tag": "div",
  "class": "sima-asesoria-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Mostrar botón",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto del botón",
      "default": "Asesoría por WhatsApp"
    },
    {
      "type": "text",
      "id": "link",
      "label": "WhatsApp",
      "default": "https://wa.me/573189154899"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Mensaje inicial",
      "default": "Hola, quiero asesoría."
    }
  ],
  "presets": [
    {
      "name": "SIMA — Asesoría",
      "settings": {
        "enabled": true,
        "label": "Asesoría por WhatsApp",
        "link": "https://wa.me/573189154899",
        "message": "Hola, quiero asesoría."
      }
    }
  ]
}
{% endschema %}
