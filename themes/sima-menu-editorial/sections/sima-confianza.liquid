<section class="sima-confianza" style="--sima-confianza-bg: {{ section.settings.background }};">
  <ul class="sima-confianza__list">
    {%- for block in section.blocks -%}
      <li class="sima-confianza__item" {{ block.shopify_attributes }}>
        <span class="sima-confianza__icon">
          {%- case block.settings.icon -%}
            {%- when 'lock' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.2 18.7 5.6v5.1c0 4.2-2.8 7.9-6.7 8.9-3.9-1-6.7-4.7-6.7-8.9V5.6L12 3.2Z"/><rect x="9.3" y="10.6" width="5.4" height="4.4" rx="0.9"/><path d="M10.4 10.6V9a1.6 1.6 0 0 1 3.2 0v1.6"/></svg>
            {%- when 'refresh' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.4 12.4A7.7 7.7 0 0 1 12.1 4.3c2.8 0 5.3 1.5 6.7 3.8"/><path d="m15.2 7.6 3.6.5.6-3.6"/><path d="M19.6 11.6a7.7 7.7 0 0 1-7.7 8.1c-2.8 0-5.3-1.5-6.7-3.8"/><path d="m8.8 16.4-3.6-.5-.6 3.6"/></svg>
            {%- when 'headset' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.8 13.4v-2.2a7.2 7.2 0 0 1 14.4 0v2.2"/><rect x="3.1" y="12.4" width="3.5" height="5.6" rx="1.75"/><rect x="17.4" y="12.4" width="3.5" height="5.6" rx="1.75"/><path d="M19.15 18v1.7a1.9 1.9 0 0 1-1.9 1.9h-2.6"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.6" y="5.8" width="10.6" height="9.4" rx="0.8"/><path d="M14.2 9.2h3.5l2.7 2.8v3.2h-6.2z"/><circle cx="8.2" cy="16.9" r="1.8"/><circle cx="17.4" cy="16.9" r="1.8"/></svg>
          {%- endcase -%}
        </span>
        <div>
          <p class="sima-confianza__title">{{ block.settings.title | newline_to_br }}</p>
          {%- if block.settings.text != blank -%}
            <p class="sima-confianza__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .sima-confianza {
    display: block;
    background: var(--sima-confianza-bg, #121212);
    color: #fff;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .sima-confianza__list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 2.5rem var(--page-margin);
    list-style: none;
  }

  .sima-confianza__item {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.75rem;
  }

  .sima-confianza__icon {
    display: flex;
    flex-shrink: 0;
    width: 1.875rem;
    height: 1.875rem;
  }

  .sima-confianza__icon svg {
    width: 100%;
    height: 100%;
  }

  .sima-confianza__title,
  .sima-confianza__text {
    margin: 0;
  }

  .sima-confianza__title {
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .sima-confianza__text {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  @media screen and (min-width: 640px) {
    .sima-confianza__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (min-width: 1280px) {
    .sima-confianza__list {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0;
    }

    .sima-confianza__item {
      padding-inline: 1.5rem;
    }

    .sima-confianza__item:not(:first-child)::before {
      content: "";
      position: absolute;
      left: 0;
      top: 50%;
      width: 1px;
      height: 3.5rem;
      background: #fff;
      transform: translateY(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SIMA — Confianza",
  "tag": "section",
  "class": "sima-confianza-section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ítem",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "lock", "label": "Pago" },
            { "value": "refresh", "label": "Cambios" },
            { "value": "headset", "label": "Atención" }
          ],
          "default": "truck"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Título",
          "default": "ENVÍOS A\nTODA COLOMBIA"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Rápidos y seguros."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "SIMA — Confianza"
    }
  ]
}
{% endschema %}
