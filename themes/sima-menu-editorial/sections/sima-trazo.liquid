<sima-trazo class="sima-trazo" style="--sima-trazo-bg: {{ section.settings.background }};">
  <div class="sima-trazo__main">
    <div>
      <p class="sima-trazo__headline">
        {{ section.settings.heading }}
        {%- if section.settings.heading_muted != blank -%}
          <span>{{ section.settings.heading_muted }}</span>
        {%- endif -%}
      </p>
      {%- if section.settings.newsletter_text != blank -%}
        <p class="sima-trazo__invite">{{ section.settings.newsletter_text }}</p>
      {%- endif -%}

      {% form 'customer', class: 'sima-trazo__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="sima-trazo__field">
          <label class="sima-trazo__sr" for="SimaTrazoEmail-{{ section.id }}">Correo electrónico</label>
          <input
            id="SimaTrazoEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            required
            autocomplete="email"
            placeholder="{{ section.settings.newsletter_placeholder }}"
          >
          <button type="submit">{{ section.settings.newsletter_button }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="sima-trazo__status" role="status">{{ section.settings.newsletter_success }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="sima-trazo__status" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {% endform %}
    </div>

    <div class="sima-trazo__cols">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div {{ block.shopify_attributes }}>
            <p class="sima-trazo__label">{{ block.settings.title }}</p>
            <ul class="sima-trazo__links">
              {%- for index in (1..6) -%}
                {%- liquid
                  assign label_id = 'link_' | append: index | append: '_label'
                  assign url_id = 'link_' | append: index | append: '_url'
                  assign label = block.settings[label_id]
                  assign url = block.settings[url_id]
                -%}
                {%- if label != blank and url != blank -%}
                  <li>
                    <a href="{{ url }}" {% if url contains 'http' %}target="_blank" rel="noreferrer"{% endif %}>{{ label }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div>
        <p class="sima-trazo__label">{{ section.settings.social_title }}</p>
        <ul class="sima-trazo__links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' and block.settings.label != blank and block.settings.link != blank -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link }}" target="_blank" rel="noreferrer">
                  {%- if block.settings.icon == 'whatsapp' -%}
                    <svg class="sima-trazo__wa" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.34 4.94L2 22l5.39-1.41a10 10 0 0 0 4.65 1.18h.01c5.46 0 9.89-4.4 9.89-9.83C21.93 6.4 17.5 2 12.04 2Zm5.76 13.92c-.24.68-1.4 1.25-1.94 1.33-.5.08-1.12.11-1.81-.11-.42-.14-.95-.31-1.64-.6-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.09 1-2.37.24-.28.64-.4.86-.4h.62c.2 0 .46-.07.72.55.28.66.94 2.28 1.02 2.45.08.16.14.36.03.58-.1.22-.16.36-.32.55-.16.19-.34.42-.48.56-.16.16-.32.33-.14.64.19.31.83 1.37 1.78 2.22 1.23 1.09 2.26 1.43 2.58 1.59.32.16.5.13.69-.08.19-.21.78-.91 1-1.22.21-.31.42-.26.7-.16.28.1 1.79.84 2.1.99.3.16.5.23.58.36.07.13.07.76-.17 1.44Z"/>
                    </svg>
                  {%- endif -%}
                  <span>{{ block.settings.label }}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>

  <p class="sima-trazo__word" aria-hidden="true">
    <span>S</span><span>I</span><span>M</span><span>A</span>
  </p>

  <div class="sima-trazo__legal">
    <div class="sima-trazo__brand">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 480
          | image_tag: class: 'sima-trazo__logo', alt: shop.name, widths: '160, 240, 320, 480', loading: 'lazy'
        }}
      {%- endif -%}
      {%- if section.settings.logo_caption != blank -%}
        <p class="sima-trazo__caption">{{ section.settings.logo_caption }}</p>
      {%- endif -%}
      <p class="sima-trazo__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</p>
    </div>
    <p class="sima-trazo__motto">{{ section.settings.motto }}</p>
    <button type="button" class="sima-trazo__top" data-sima-top>{{ section.settings.back_label }}</button>
  </div>
</sima-trazo>

<script>
  if (!customElements.get('sima-trazo')) {
    customElements.define(
      'sima-trazo',
      class extends HTMLElement {
        connectedCallback() {
          const button = this.querySelector('[data-sima-top]');
          button?.addEventListener('click', () => {
            const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
            const scroller = document.querySelector('.page-wrapper');
            if (scroller) scroller.scrollTo({ top: 0, behavior });
            else window.scrollTo({ top: 0, behavior });
          });
        }
      }
    );
  }
</script>

{% stylesheet %}
  .sima-trazo {
    display: block;
    overflow: hidden;
    background: var(--sima-trazo-bg, #121212);
    color: #fff;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .sima-trazo__main,
  .sima-trazo__word,
  .sima-trazo__legal {
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sima-trazo__main {
    display: grid;
    gap: 3.5rem;
    padding-block: 4rem;
  }

  .sima-trazo__headline {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .sima-trazo__headline span {
    color: rgb(255 255 255 / 0.35);
  }

  .sima-trazo__invite {
    margin: 2.5rem 0 0;
    color: rgb(255 255 255 / 0.7);
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .sima-trazo__form {
    max-width: 28rem;
    margin-top: 1rem;
  }

  .sima-trazo__field {
    display: flex;
    align-items: stretch;
    height: 3rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.4);
  }

  .sima-trazo__field:focus-within {
    border-bottom-color: #fff;
  }

  .sima-trazo__field input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: transparent;
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    outline: none;
  }

  .sima-trazo__field input::placeholder {
    color: rgb(255 255 255 / 0.45);
  }

  .sima-trazo__field button {
    flex-shrink: 0;
    padding-left: 1.25rem;
    border: 0;
    background: transparent;
    color: #fff;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .sima-trazo__status {
    margin: 0.75rem 0 0;
    color: rgb(255 255 255 / 0.7);
    font-family: var(--font-body--family);
    font-size: 0.875rem;
  }

  .sima-trazo__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1.5rem;
    row-gap: 2.5rem;
  }

  .sima-trazo__label {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .sima-trazo__links {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sima-trazo__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgb(255 255 255 / 0.65);
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .sima-trazo__links a:hover {
    color: #fff;
  }

  .sima-trazo__wa {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  .sima-trazo__word {
    display: flex;
    justify-content: space-between;
    /* margin-block only: "margin: 0" was cancelling the margin-inline: auto that centres it. */
    margin-block: 0;
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
    font-family: var(--font-body--family);
    font-size: min(34vw, 34rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .sima-trazo__legal {
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: 1rem;
    padding-block: 1.25rem 1.5rem;
    color: rgb(255 255 255 / 0.55);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
  }

  .sima-trazo__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .sima-trazo__logo {
    display: block;
    width: 4.75rem;
    height: auto;
    mix-blend-mode: screen;
  }

  .sima-trazo__caption {
    margin: 0;
    color: rgb(255 255 255 / 0.8);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    line-height: 1;
    text-transform: uppercase;
  }

  .sima-trazo__copy,
  .sima-trazo__motto {
    margin: 0;
  }

  .sima-trazo__copy {
    margin-top: 0.25rem;
  }

  .sima-trazo__motto {
    font-family: var(--font-heading--family);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .sima-trazo__top {
    justify-self: start;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .sima-trazo__top:hover,
  .sima-trazo__links a:hover {
    color: #fff;
  }

  .sima-trazo__links a:focus-visible,
  .sima-trazo__field button:focus-visible,
  .sima-trazo__top:focus-visible,
  .sima-trazo__field input:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .sima-trazo__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (min-width: 640px) {
    .sima-trazo__cols {
      grid-template-columns: repeat(4, 1fr);
    }

    .sima-trazo__word {
      padding-top: 3.5rem;
    }

    .sima-trazo__legal {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .sima-trazo__caption {
      font-size: 0.625rem;
    }

    .sima-trazo__motto,
    .sima-trazo__top {
      align-self: center;
    }

    .sima-trazo__motto {
      text-align: center;
    }

    .sima-trazo__top {
      justify-self: end;
    }
  }

  @media screen and (min-width: 990px) {
    .sima-trazo__main {
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
      padding-block: 6rem;
    }

    .sima-trazo__cols {
      padding-top: 0.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SIMA — Trazo",
  "tag": "section",
  "class": "sima-trazo-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Frase",
      "default": "Disciplina te lleva"
    },
    {
      "type": "text",
      "id": "heading_muted",
      "label": "Frase en gris",
      "default": "donde la motivación no puede."
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Texto del boletín",
      "default": "Recibe contenido exclusivo para tu mejor versión."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Texto del campo",
      "default": "Dirección de correo electrónico"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Botón del boletín",
      "default": "Suscribirme"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Mensaje de suscripción",
      "default": "Gracias. Ya estás en la lista."
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Título de redes",
      "default": "Conecta"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "logo_caption",
      "label": "Texto del logo",
      "default": "Lifestyle"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Derechos",
      "default": "Todos los derechos reservados."
    },
    {
      "type": "text",
      "id": "motto",
      "label": "Lema",
      "default": "Disciplina · Propósito · Fe"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Volver arriba",
      "default": "Volver arriba ↑"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Tienda" },
        { "type": "text", "id": "link_1_label", "label": "Enlace 1" },
        { "type": "url", "id": "link_1_url", "label": "Destino 1" },
        { "type": "text", "id": "link_2_label", "label": "Enlace 2" },
        { "type": "url", "id": "link_2_url", "label": "Destino 2" },
        { "type": "text", "id": "link_3_label", "label": "Enlace 3" },
        { "type": "url", "id": "link_3_url", "label": "Destino 3" },
        { "type": "text", "id": "link_4_label", "label": "Enlace 4" },
        { "type": "url", "id": "link_4_url", "label": "Destino 4" },
        { "type": "text", "id": "link_5_label", "label": "Enlace 5" },
        { "type": "url", "id": "link_5_url", "label": "Destino 5" },
        { "type": "text", "id": "link_6_label", "label": "Enlace 6" },
        { "type": "url", "id": "link_6_url", "label": "Destino 6" }
      ]
    },
    {
      "type": "social",
      "name": "Red",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Instagram" },
        { "type": "url", "id": "link", "label": "Enlace" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "SIMA — Trazo" }
  ]
}
{% endschema %}
