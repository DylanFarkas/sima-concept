-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;line-height:1.15');\n    console.log('%cbuilt by edgardev%c  ·  16 years shipping code',\n      'color:#f2efe9;font-weight:700;font-family:ui-monospace,monospace;font-size:12px',\n      'color:#8a8a8a;font-family:ui-monospace,monospace;font-size:12px');\n    console.log('%cstack  ·  shopify liquid · web components · css grid · zero dependencies',\n      'color:#8a8a8a;font-family:ui-monospace,monospace;font-size:11px');\n    console.log('%cweb3 native  ·  gm',\n      'color:#8a8a8a;font-family:ui-monospace,monospace;font-size:11px');\n    console.log('%c¿curioseando el codigo? hablemos.',\n      'color:#5c5c5c;font-family:ui-monospace,monospace;font-size:11px;font-style:italic');\n  });\n</script>\n<script>\n  /* Patron de revelado del laser: cada elemento hace su recorrido cuando el\n     scroll lo trae a pantalla, no mientras el usuario se desplaza. Asi el\n     detalle se ve siempre, aunque se pare en seco. Cuando entran varios de\n     golpe -las seis tarjetas- se encienden en cascada.\n\n     Este bloque vive en el header group, o sea que se parsea antes que el\n     hero y las secciones: hay que esperar al DOM o querySelectorAll no\n     encuentra nada. */\n  (function () {\n    function iniciar() {\n      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n      if (!('IntersectionObserver' in window)) return;\n\n      var CARDS =\n        '[id$=\"__sima_collections\"] .section-content-wrapper > .group-block:last-child' +\n        ' > .group-block-content > .group-block';\n      var nodos = document.querySelectorAll('[class*=\"_cta\"], ' + CARDS);\n      if (!nodos.length) return;\n\n      var ESCALON = 140;\n\n      Array.prototype.forEach.call(nodos, function (el) {\n        el.addEventListener('animationend', function (e) {\n          if (e.animationName === 'sima-laser-run') el.removeAttribute('data-laser');\n        });\n      });\n\n      var observer = new IntersectionObserver(\n        function (entradas) {\n          var entrantes = entradas.filter(function (e) { return e.isIntersecting; });\n          entrantes.sort(function (a, b) {\n            return a.boundingClientRect.top - b.boundingClientRect.top;\n          });\n          entrantes.forEach(function (entrada, i) {\n            var el = entrada.target;\n            if (el.hasAttribute('data-laser')) return;\n            setTimeout(function () {\n              el.setAttribute('data-laser', '');\n            }, i * ESCALON);\n          });\n        },\n        { threshold: 0.3 }\n      );\n\n      Array.prototype.forEach.call(nodos, function (el) { observer.observe(el); });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', iniciar);\n    } else {\n      iniciar();\n    }\n  })();\n</script>\n<script>\n  /* Revelado en cascada de titulos, textos y botones. El escalonado sigue la\n     jerarquia real del bloque: antetitulo, titular, parrafo y CTA entran en\n     ese orden, 90 ms de diferencia, que es lo que separa \"aparecer a la vez\"\n     de \"leerse como una secuencia\".\n\n     Se revela una sola vez por elemento: repetirlo en cada pasada marea y no\n     aporta. El estado inicial lo escribe este script, asi que sin JS el\n     contenido queda visible por defecto. */\n  (function () {\n    function iniciar() {\n      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n      if (!('IntersectionObserver' in window)) return;\n\n      var SECCIONES = [\n        '[id*=\"__hero_\"]',\n        '[id$=\"__sima_values\"]',\n        '[id$=\"__sima_collections\"]',\n        '[id$=\"__sima_about\"]',\n        '[id$=\"__sima_trust\"]'\n      ];\n      var SELECTOR = SECCIONES.map(function (s) {\n        return s + ' .text-block, ' + s + ' [class*=\"_cta\"]';\n      }).join(', ');\n\n      var revelables = document.querySelectorAll(SELECTOR);\n      if (!revelables.length) return;\n\n      Array.prototype.forEach.call(revelables, function (el) {\n        el.setAttribute('data-reveal', '');\n      });\n\n      var observer = new IntersectionObserver(\n        function (entradas) {\n          entradas.forEach(function (entrada) {\n            if (!entrada.isIntersecting) return;\n            var el = entrada.target;\n            var indice = 0;\n            if (el.parentElement) {\n              var hermanos = el.parentElement.querySelectorAll(':scope > [data-reveal]');\n              indice = Math.max(0, Array.prototype.indexOf.call(hermanos, el));\n            }\n            el.style.setProperty('--reveal-delay', indice * 90 + 'ms');\n            el.setAttribute('data-reveal', 'in');\n            observer.unobserve(el);\n          });\n        },\n        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }\n      );\n\n      Array.prototype.forEach.call(revelables, function (el) { observer.observe(el); });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', iniciar);\n    } else {\n      iniciar();\n    }\n  })();\n</script>\n<script>\n  /* Activa el suavizado de scroll cuando la pagina ya se asento, para que la\n     restauracion de posicion al recargar siga siendo instantanea. */\n  (function () {\n    function activar() {\n      requestAnimationFrame(function () {\n        requestAnimationFrame(function () {\n          document.documentElement.classList.add('sima-smooth');\n        });\n      });\n    }\n    if (document.readyState === 'complete') activar();\n    else window.addEventListener('load', activar);\n  })();\n</script>",
